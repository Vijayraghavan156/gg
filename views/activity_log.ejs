<%- include('partials/header', { title: 'Activity log', user, ws, active: 'activity' }) %>
<% const zoneOfWs = (() => { const z = (typeof ws !== 'undefined' && ws && (ws.timezone || ws.firm_timezone)) || 'UTC'; try { new Intl.DateTimeFormat('en-GB', { timeZone: z }); return z; } catch (_) { return 'UTC'; } })();
   const asDate = v => { if (v == null || v === '') return null; const s = String(v); const d = v instanceof Date ? v : new Date(/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}/.test(s) ? s.replace(' ', 'T') + 'Z' : s); return Number.isNaN(d.getTime()) ? null : d; };
   const zoneLabel = d => { for (const loc of ['en-IN', 'en-US', 'en-GB']) { const n = (new Intl.DateTimeFormat(loc, { timeZone: zoneOfWs, timeZoneName: 'short' }).formatToParts(d).find(p => p.type === 'timeZoneName') || {}).value || ''; if (/^[A-Z]{2,5}$/.test(n)) return n; } return zoneOfWs; };
   const dayIn = v => { const d = asDate(v); return d ? new Intl.DateTimeFormat('en-GB', { timeZone: zoneOfWs, day: 'numeric', month: 'short', year: 'numeric' }).format(d) : ''; };
   const dayTimeIn = v => { const d = asDate(v); return d ? dayIn(d) + ', ' + new Intl.DateTimeFormat('en-GB', { timeZone: zoneOfWs, hour: 'numeric', minute: '2-digit', hour12: true }).format(d).replace(/\s+/g, ' ').replace(/\b(AM|PM)\b/, s => s.toLowerCase()) + ' ' + zoneLabel(d) : ''; }; %>

<style>
  @media (max-width: 600px) {
    .activity-diff-grid { grid-template-columns: 1fr !important; }
    .activity-diff-grid pre { overflow-wrap: anywhere; }
  }
</style>

<div class="page-head">
  <div>
    <h1 class="page-title">Activity log</h1>
    <div class="page-subtitle">Tamper-evident record of every change. Filter by user, action, type or date.<% if (typeof tprmActivity !== 'undefined' && tprmActivity.available) { %> Third-party risk actions for this client follow the main log.<% } %></div>
  </div>
  <a href="/workspaces/<%= ws.id %>/activity-log.csv?<%= new URLSearchParams(filters).toString() %>" class="btn btn-secondary btn-xs">Export CSV</a>
</div>

<%- include('partials/activity_tabs', { ws, tab: 'log' }) %>

<div class="panel" style="margin-bottom:14px">
  <form method="GET" action="/workspaces/<%= ws.id %>/activity-log" class="panel-pad stack-grid" style="--cols:repeat(6,1fr);gap:10px;align-items:end;">
    <div>
      <label class="label">User</label>
      <select class="select" name="user_id">
        <option value="">All</option>
        <% users.forEach(u => { %><option value="<%= u.id %>" <%= filters.user_id == u.id ? 'selected' : '' %>><%= u.name %></option><% }) %>
      </select>
    </div>
    <div>
      <label class="label">Action</label>
      <select class="select" name="action">
        <option value="">All</option>
        <% actions.forEach(a => { %><option value="<%= a %>" <%= filters.action === a ? 'selected' : '' %>><%= a %></option><% }) %>
      </select>
    </div>
    <div>
      <label class="label">Entity type</label>
      <select class="select" name="entity_type">
        <option value="">All</option>
        <% types.forEach(t => { %><option value="<%= t %>" <%= filters.entity_type === t ? 'selected' : '' %>><%= t %></option><% }) %>
      </select>
    </div>
    <div><label class="label">From</label><input class="input" type="date" name="from" value="<%= filters.from %>"></div>
    <div><label class="label">To</label><input class="input" type="date" name="to" value="<%= filters.to %>"></div>
    <div class="row"><input class="input" name="q" placeholder="search…" value="<%= filters.q %>"><button class="btn btn-primary btn-xs">Apply</button></div>
  </form>
</div>

<div class="panel" style="overflow:hidden">
  <table class="t">
    <thead><tr><th style="width:160px">When</th><th>User</th><th>Action</th><th>Entity</th><th>Details / diff</th><th>IP</th></tr></thead>
    <tbody>
      <% log.forEach(l => { %>
        <tr>
          <td class="meta text-sm" data-activity-when><time datetime="<%= (asDate(l.created_at) || { toISOString: () => '' }).toISOString() %>"><%= dayTimeIn(l.created_at) || l.created_at %></time></td>
          <td><%= l.user_name %></td>
          <td class="mono text-base"><%= l.action %></td>
          <td class="meta">
            <% if (l.entity_type) { %><%= l.entity_type %><% if (l.entity_id) { %> #<%= l.entity_id %><% } %><% } else { %>-<% } %>
          </td>
          <td class="meta" style="max-width:520px">
            <% if (l.before_state || l.after_state) { %>
              <details>
                <summary class="text-sm" style="cursor:pointer;color:var(--accent);">show diff</summary>
                <div class="text-sm activity-diff-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:6px;font-family:ui-monospace,monospace;">
                  <div class="text-danger" style="background:rgba(220,38,38,0.06);padding:6px 8px;border-radius:4px;"><strong>Before</strong><pre style="white-space:pre-wrap;margin:4px 0 0;"><%= l.before_state || '{}' %></pre></div>
                  <div class="text-success" style="background:rgba(22,163,74,0.06);padding:6px 8px;border-radius:4px;"><strong>After</strong><pre style="white-space:pre-wrap;margin:4px 0 0;"><%= l.after_state || '{}' %></pre></div>
                </div>
              </details>
            <% } else if (l.details) { %>
              <span class="text-sm" style="font-family:ui-monospace,monospace;"><%= l.details.length > 80 ? l.details.slice(0,80) + '…' : l.details %></span>
            <% } else { %>
              -
            <% } %>
          </td>
          <td class="meta mono text-xs"><%= l.ip_address || '-' %></td>
        </tr>
      <% }) %>
      <% if (log.length === 0) { %>
        <tr><td colspan="6" style="padding:0"><div class="empty-state"><div class="empty-sub">No activity matches these filters.</div></div></td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('partials/pager', { pg, pagerHref }) %>

<% if (typeof tprmActivity !== 'undefined' && tprmActivity.available) { %>
<section class="panel" style="overflow:hidden;margin-top:18px" data-activity-third-party-risk>
  <div class="panel-head"><h2>Third-party risk</h2><span class="meta text-sm"><%= tprmActivity.total > tprmActivity.list.length ? `Newest ${tprmActivity.list.length} of ${tprmActivity.total}` : `${tprmActivity.total} action${tprmActivity.total === 1 ? '' : 's'}` %></span></div>
  <table class="t">
    <thead><tr><th style="width:180px">When</th><th style="width:220px">Third party</th><th>What happened</th></tr></thead>
    <tbody>
      <% tprmActivity.list.forEach(e => { %>
        <tr data-activity-tprm-event="<%= e.id %>">
          <td class="meta text-sm"><%= e.when %></td>
          <td><%= e.thirdParty || '-' %></td>
          <td><%= e.text %></td>
        </tr>
      <% }) %>
      <% if (!tprmActivity.list.length) { %>
        <tr><td colspan="3" style="padding:0"><div class="empty-state"><div class="empty-sub">No third-party risk actions match these filters.</div></div></td></tr>
      <% } %>
    </tbody>
  </table>
</section>
<% } %>

<%- include('partials/footer') %>
