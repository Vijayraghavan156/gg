<%- include('partials/header', { title: page.thirdParty.name + ' · Third-party risk', user, ws, active, portalView }) %>
<%
  const p = page;
  const r = p.recommendation;
  const a = p.assessment;
  const base = '/workspaces/' + ws.id + '/client-portal/third-party-risk';
  const csrf = typeof csrfToken !== 'undefined' ? csrfToken : '';
  const dash = x => (x == null || x === '') ? '-' : x;
  const day = d => d ? tpf.day(d) : '-';
  const size = n => tpf.fileSize(Number(n) || 0);
  const typeLabel = a.type === 'onboarding' ? 'Onboarding assessment' : 'Reassessment';
  const v = values || {};
  const chosen = v.outcome || '';
  const showDivergence = !!chosen && chosen !== D.MORE_INFORMATION && chosen !== r.outcome;
%>
<div class="tpu-mb-10"><a class="text-xs tpu-back" href="<%= base %>">← Third-party risk</a></div>
<div class="page-head cp-page-head" data-tprm-portal-recommendation="<%= r.id %>">
  <div>
    <div class="eyebrow"><%= typeLabel %> · version <%= r.version %></div>
    <h1><%= p.thirdParty.name %></h1>
    <div class="page-subtitle"><%= tp.STATUS_LABELS[p.thirdParty.status] %> · <%- p.approval ? include('partials/tprm_status', { text: p.approval.state === 'awaiting_approval' && r.status === 'issued' ? 'Waiting for your decision' : p.approval.label, tone: p.approval.tone, attrs: 'data-tprm-approval="' + escapeHtml(p.approval.state) + '"' }) : '<span data-tprm-approval=""></span>' %></div>
  </div>
  <% if (r.status === 'issued') { %><%- include('partials/tprm_status', { text: 'Issued ' + day(r.issued_at) }) %>
  <% } else { %><%- include('partials/tprm_status', { text: 'Replaced by version ' + dash(r.superseded_by_version), attrs: 'data-tprm-portal-superseded' }) %><% } %>
</div>

<% const meaning = ({
     approve: 'You can ' + (a.type === 'onboarding' ? 'start using' : 'keep using') + ' ' + p.thirdParty.name + ' for this service' + (r.valid_until ? '. This recommendation is valid until ' + day(r.valid_until) + '.' : '.'),
     approve_with_conditions: 'You can ' + (a.type === 'onboarding' ? 'start using' : 'keep using') + ' ' + p.thirdParty.name + ' for this service if the conditions below are met by their due dates' + (r.valid_until ? '. This recommendation is valid until ' + day(r.valid_until) + '.' : '.'),
     reject: 'We advise against ' + (a.type === 'onboarding' ? 'using' : 'continuing with') + ' ' + p.thirdParty.name + ' for this service: the risks below are not acceptable.',
   })[r.outcome] || ''; %>
<section class="tpa tprm-brief" data-tprm-portal-rec>
  <p class="tprm-brief-lead">We recommend: <strong data-tprm-portal-rec-outcome><%= r.outcome_label %></strong>. <%= meaning %></p>
  <p class="tpa-meta">Residual risk <%= rec.RESIDUAL_LABELS[r.residual_rating] ? rec.RESIDUAL_LABELS[r.residual_rating].toLowerCase() : 'not rated' %> · tier <span data-tprm-portal-final-tier><%= a.final_tier ? tp.TIER_LABELS[a.final_tier] : '-' %></span> · <span data-tprm-portal-rec-valid-until="<%= r.valid_until ? 'set' : (r.outcome === 'reject' ? 'not_needed' : 'not_set') %>"><%= r.valid_until ? 'valid until ' + day(r.valid_until) : (r.outcome === 'reject' ? 'no expiry (not needed for ' + r.outcome_label + ')' : 'no expiry set') %></span><% if (r.status === 'issued') { %> · <a href="<%= base %>/recommendations/<%= r.id %>/report.pdf" data-tprm-portal-report>The full report (PDF)</a><% } %></p>
  <div class="tprm-brief-block">
    <h2 class="tpa-h">Why</h2>
    <p class="tpa-pre" data-tprm-portal-rec-rationale><%= r.rationale %></p>
    <p class="tpa-meta" data-tprm-portal-tier><span data-tprm-portal-tier-reason>Tier: <%= dash(a.tier_explanation) %></span><% if (a.override_direction && a.override_direction !== 'none') { %> <span data-tprm-portal-tier-override><%= a.override_direction === 'raise' ? 'Raised' : 'Lowered' %> from <%= tp.TIER_LABELS[a.scored_tier] %>: <%= a.override_reason %></span><% } %></p>
  </div>
  <% if (p.questionnaireNotReturned) { %><p class="tpa-meta" data-tprm-portal-not-returned>Questionnaire not returned by the third party.</p><% } %>
  <div class="tprm-brief-block" data-tprm-portal-findings>
    <h2 class="tpa-h">What we found<span class="tpa-meta-inline"> (<%= p.findings.length %>)</span></h2>
    <% if (!p.findings.length) { %>
      <p class="tpa-meta">No findings were recorded on this assessment.</p>
    <% } else { %>
      <ol class="tprm-brief-list">
        <% p.findings.forEach(f => { %>
          <li data-tprm-portal-finding="<%= f.id %>"><p><span class="tpa-strong"><%= f.title %></span> <span class="tpa-meta-inline"><%= fd.SEVERITY_LABELS[f.severity] %><% if (f.control_ref) { %> · <%= f.control_ref %><% } %> · <%= fd.STATUS_LABELS[f.status] %></span></p>
            <% if (f.description) { %><p class="tpa-pre"><%= f.description %></p><% } %>
            <% if (f.impact) { %><p class="tpa-pre"><span class="tpa-strong">Why it matters:</span> <%= f.impact %></p><% } %></li>
        <% }) %>
      </ol>
    <% } %>
  </div>
  <% if (r.conditions.length) { %>
  <div class="tprm-brief-block" data-tprm-portal-conditions>
    <h2 class="tpa-h">Conditions</h2>
    <ol class="tprm-brief-list">
      <% r.conditions.forEach((c, i) => { %>
        <li data-tprm-portal-condition><p class="tpa-pre"><%= c.description %></p>
          <p class="tpa-meta" data-tprm-portal-condition-owner="<%= c.owner %>">Who: <%= c.owner === 'client' ? 'You (the client)' : (rec.CONDITION_OWNER_LABELS[c.owner] || '-') %> · by <%= day(c.due_date) %></p></li>
      <% }) %>
    </ol>
  </div>
  <% } %>
  <div class="tprm-brief-block" data-tprm-portal-after>
    <h2 class="tpa-h">What happens after you decide</h2>
    <p>Your decision is recorded with your name and the date, and it is final for version <%= r.version %>. If you agree with the recommendation, it takes effect as it stands<%= r.conditions.length ? ', and your consultants follow up each condition until it is met' : '' %>. If you choose another option, you accept the risk of going against the advice: give your reasons and the date that acceptance ends. If you ask for more information, your consultants answer it in a revised recommendation and you decide again.</p>
  </div>
</section>

<div class="panel tpu-mb-14" data-tprm-portal-evidence>
  <div class="panel-head"><h2>Files shared with you</h2><span class="meta"><%= p.evidence.length %></span></div>
  <% if (!p.evidence.length) { %>
    <div class="panel-pad meta">Your consultants have not shared any files from this assessment.</div>
  <% } else { %>
    <div class="table-scroll"><table class="t"><thead><tr><th>File</th><th class="tpu-w-100">Size</th><th class="tpu-w-120">Shared</th></tr></thead><tbody>
      <% p.evidence.forEach(e => { %>
        <tr data-tprm-portal-file="<%= e.id %>">
          <td><a href="<%= base %>/recommendations/<%= r.id %>/evidence/<%= e.id %>/download"><%= e.original_name %></a></td>
          <td><%= size(e.size_bytes) %></td><td><%= day(e.released_at) %></td>
        </tr>
      <% }) %>
    </tbody></table></div>
  <% } %>
</div>

<div class="panel tpu-mb-14" id="decision" data-tprm-portal-decision>
  <div class="panel-head"><h2>Your decision</h2></div>
  <% if (p.decision) { const d = p.decision; %>
    <div class="panel-pad" data-tprm-portal-decided="<%= d.outcome %>">
      <div><strong><%= p.labels[d.outcome] %></strong> <span class="meta">· <%= dash(d.decided_by_name) %> · <%= day(d.decided_at) %></span></div>
      <% if (d.diverges) { %><div class="tpu-mt-6"><%- include('partials/tprm_status', { text: 'Differs from the recommendation. Risk accepted until ' + day(d.risk_acceptance_until) + '.', tone: 'attention' }) %></div><% } %>
      <% if (d.rationale) { %><div class="tpu-pre tpu-mt-6"><%= d.rationale %></div><% } %>
      <% if (d.outcome === D.MORE_INFORMATION) { %><div class="meta tpu-mt-6">Your consultants will issue a revised recommendation for you to decide on.</div><% } %>
    </div>
  <% } else if (p.canDecide) { %>
    <form method="POST" action="<%= base %>/recommendations/<%= r.id %>/decision" class="panel-pad tpu-form" data-tprm-decision-form data-recommended="<%= r.outcome %>" data-more="<%= D.MORE_INFORMATION %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><%- include('partials/tprm_confirm_fields', { title: 'Record your decision?', body: 'Your decision is recorded with your name and today\'s date, and it is final for version ' + r.version + '.', action: 'Record decision' }) %>
      <% if (errors && errors.length) { %>
        <div class="callout tpu-problem-edge" role="alert" data-tprm-form-errors>
          <div class="callout-title tpu-problem-text">Your decision was not recorded</div>
          <ul class="tpu-list"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
        </div>
      <% } %>
      <fieldset class="tpu-fieldset" data-tprm-decision-outcomes>
        <legend class="label tpu-p-0">Decision</legend>
        <% D.OUTCOMES.forEach(o => { %>
          <label class="tpu-row tpu-my-4">
            <input type="radio" name="outcome" value="<%= o %>" <%= chosen === o ? 'checked' : '' %> required<%- o === D.MORE_INFORMATION ? ' data-more' : (o !== r.outcome ? ' data-diverges' : '') %>> <span><%= p.labels[o] %></span>
            <% if (o === r.outcome) { %><span class="meta text-xs">(recommended)</span><% } %>
          </label>
        <% }) %>
      </fieldset>
      <div class="callout tpu-attention-edge" role="alert" data-tprm-divergence-warning <%= showDivergence ? '' : 'hidden' %>>
        <div class="callout-title tpu-attention-text">Your decision differs from the recommendation (<%= r.outcome_label %>)</div>
        <div>You are accepting the risk of going against your consultants' advice. Give your rationale and the date this risk acceptance expires: both are recorded with your decision.</div>
      </div>
      <div data-tprm-decision-rationale><label class="label" for="decision-rationale">Rationale</label>
        <textarea class="input" id="decision-rationale" name="rationale" rows="4" maxlength="<%= D.LIMITS.rationale %>"><%= v.rationale || '' %></textarea>
        <div class="meta text-xs">Required if your decision differs from the recommendation, or to say what more information you need.</div></div>
      <div data-tprm-risk-acceptance><label class="label" for="decision-risk-until">Risk acceptance expires</label>
        <input class="input tprm-portal-date" id="decision-risk-until" type="date" name="risk_acceptance_until" value="<%= v.risk_acceptance_until || '' %>">
        <div class="meta text-xs">Only when your decision differs from the recommendation.</div></div>
      <div class="tprm-portal-decide-foot">
        <span class="meta">Your decision is final for version <%= r.version %>: it cannot be changed afterwards.</span>
        <button class="btn btn-primary" type="submit" data-tprm-decide>Record decision</button>
      </div>
    </form>
    <script>
    (function () {
      var form = document.querySelector('[data-tprm-decision-form]');
      if (!form) return;
      var warn = form.querySelector('[data-tprm-divergence-warning]');
      function update() {
        var picked = form.querySelector('input[name="outcome"]:checked');
        var v = picked ? picked.value : '';
        warn.hidden = !(v && v !== form.dataset.recommended && v !== form.dataset.more);
      }
      form.addEventListener('change', update);
      update();
    })();
    </script>
  <% } else if (p.waiting && !p.ownerNamed) { %>
    <div class="panel-pad meta" data-tprm-portal-owner-missing>Waiting for your firm to name a decision owner.</div>
  <% } else if (p.waiting) { %>
    <div class="panel-pad meta" data-tprm-portal-waiting>Waiting for <%= dash(a.client_decision_owner_name) %>, your decision owner, to decide.</div>
  <% } else if (p.revising) { %>
    <div class="panel-pad meta" data-tprm-portal-revising>Your consultants are revising this recommendation. You will decide on the revised version.</div>
  <% } else if (r.status !== 'issued') { %>
    <div class="panel-pad meta">This version was replaced by a later one<% const later = p.otherVersions.find(x => x.status === 'issued'); if (later) { %>: <a href="<%= base %>/recommendations/<%= later.id %>">open version <%= later.version %></a><% } %>.</div>
  <% } else { %>
    <div class="panel-pad meta">No decision was recorded on this recommendation.</div>
  <% } %>
</div>

<% if (p.conditionTracking) { %><%- include('tprm_portal_conditions') %><% } %>
<% if (p.otherVersions.length) { %>
<div class="panel tpu-mb-14" data-tprm-portal-versions>
  <div class="panel-head"><h2>Other versions</h2></div>
  <% p.otherVersions.forEach(x => { const d = p.decisions.find(y => Number(y.recommendation_id) === Number(x.id)); %>
    <div class="panel-pad tpu-rule-top">
      <a href="<%= base %>/recommendations/<%= x.id %>">Version <%= x.version %></a> · <%= p.labels[x.outcome] %>
      <span class="meta text-xs">issued <%= day(x.issued_at) %><%= d ? ' · your decision: ' + p.labels[d.outcome] : '' %></span>
    </div>
  <% }) %>
</div>
<% } %>
<%- include('partials/footer') %>
