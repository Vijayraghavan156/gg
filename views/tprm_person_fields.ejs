<div><label class="label" for="<%= idp %>-name">Name</label><input class="input" id="<%= idp %>-name" name="name" maxlength="200" value="<%= v.name || '' %>" required></div>
<div><label class="label" for="<%= idp %>-email">Email</label><input class="input" id="<%= idp %>-email" type="email" name="email" maxlength="200" value="<%= v.email || '' %>" required></div>
<div><label class="label" for="<%= idp %>-title">Job title <span class="meta text-xs">(optional)</span></label><input class="input" id="<%= idp %>-title" name="job_title" maxlength="200" value="<%= v.job_title || '' %>"></div>
<div><label class="label" for="<%= idp %>-phone">Phone <span class="meta text-xs">(optional)</span></label><input class="input" id="<%= idp %>-phone" type="tel" name="phone" maxlength="60" value="<%= v.phone || '' %>"></div>
