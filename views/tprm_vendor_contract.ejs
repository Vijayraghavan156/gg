<%
  const base = locals.base || ('/vendor/q/' + token);
  const errorList = (errors || []).map(e => String(e && typeof e === 'object' ? e.message : e));
  const posted = values && typeof values === 'object' ? values : null;
  const cur = (r, k) => posted && posted[r.clause_id] && posted[r.clause_id][k] != null ? String(posted[r.clause_id][k]) : (k === 'status' ? (r.vendor_status || '') : (r.vendor_reference || ''));
  let lastCat = null;
%><!doctype html>
<html lang="en" class="page-standalone" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <link rel="stylesheet" href="/app.css">
<%- include('tprm_portal_head', { title: 'Contract clauses · ' + p.clientName, frame }) %>
</head>
<body class="vq-body">
  <a class="vq-skip" href="#main">Skip to the content</a>
  <%- include('partials/tprm_portal_top', { frame }) %>
  <div class="vq-frame">
    <%- include('partials/tprm_portal_side', { frame }) %>
    <main class="vq-main" id="main" data-vendor-contract>
      <header class="vq-top">
        <div class="vq-top-main">
          <h1 class="vq-title">Contract clauses</h1>
          <p class="vq-top-meta">For your contract with <span data-vendor-client><%= p.clientName %></span>. <span data-vendor-contract-progress><%= c.answered %> of <%= c.total %> marked</span>.</p>
        </div>
        <div class="vq-toolbar"><a class="vq-btn vq-btn--secondary" href="<%= base %>" data-vendor-contract-back>Questionnaire</a></div>
      </header>
      <p class="vq-start-note">For each clause, say whether your contract with <%= p.clientName %> has it, and give the clause number. The reviewers check your answers against the contract, and <%= p.clientName %> sees the result. If there is no signed contract yet, choose "No signed contract yet".</p>
      <% if (notice) { %><p class="vq-notice" role="status" data-vendor-notice><%= notice %></p><% } %>
      <% if (errorList.length) { %>
        <div class="vq-errors" role="alert" data-vendor-errors><p class="vq-errors-title">Nothing was saved. Correct the following:</p><ul><% errorList.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
      <% } %>
      <% if (!c.open) { %><p class="vq-muted" data-vendor-contract-locked>The questionnaire has been sent, so these answers can no longer be changed.</p><% } %>
      <form method="POST" action="<%= base %>/contract" data-vendor-contract-form>
        <input type="hidden" name="_aft" value="<%= aft %>">
        <% c.rows.forEach(r => { %>
          <% if (r.category && r.category !== lastCat) { lastCat = r.category; %><h2 class="vq-h2 vq-mt"><%= r.category %></h2><% } %>
          <fieldset class="vq-item vq-clause" id="clause-<%= r.clause_id %>" data-vendor-clause="<%= r.clause_id %>"<%= c.open ? '' : ' disabled' %>>
            <legend class="vq-h3"><span class="vq-item-ref"><%= r.clause_id %></span> <%= r.requirement %></legend>
            <div class="vq-choices">
              <% statuses.forEach(s => { %><label class="vq-choice"><input class="vq-choice-input" type="radio" name="rows[<%= r.clause_id %>][status]" value="<%= s %>" <%= cur(r, 'status') === s ? 'checked' : '' %>> <%= labels[s] %></label><% }) %>
            </div>
            <div class="vq-field"><label class="vq-label" for="ref-<%= r.clause_id %>">Clause number or reference <span class="vq-optional">optional</span></label>
              <input class="vq-input" id="ref-<%= r.clause_id %>" name="rows[<%= r.clause_id %>][reference]" maxlength="300" value="<%= cur(r, 'reference') %>" placeholder="For example: clause 14.2, or schedule 4"></div>
          </fieldset>
        <% }) %>
        <% if (c.open && c.rows.length) { %><div class="vq-actions vq-actions--bar"><span class="vq-actions-gap"></span><button class="vq-btn vq-btn--primary" type="submit" data-vendor-contract-save>Save</button></div><% } %>
      </form>
      <%- include('partials/tprm_vendor_footer', { firm: p.firm, expiresAt: null, note: locals.signedIn ? '' : 'Do not share this link.' }) %>
    </main>
  </div>
</body>
</html>
