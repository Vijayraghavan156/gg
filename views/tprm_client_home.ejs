<%- include('partials/header', { title: tpClient.name + ' · Third-party risk', user, active }) %>
<%
  const list = registerList;
  const f = list.filters;
  const isDueView = f.view === 'due';
  const qs = extra => { const p = new URLSearchParams(); if (isDueView) p.set('view', 'due'); Object.entries(extra).forEach(([k, v]) => { if (v) p.set(k, v); }); const s = p.toString(); return s ? '?' + s : ''; };
  const sortHref = key => '/tprm/clients/' + tpClient.id + qs({ status: f.status, tier: f.tier, due: f.due, q: f.q, sort: key, dir: f.sort === key && f.dir === 'asc' ? 'desc' : 'asc' });
  const ariaSort = key => (f.sort === key ? ' aria-sort="' + (f.dir === 'desc' ? 'descending' : 'ascending') + '"' : '');
  const sortTh = (key, label, cls) => '<th data-tp-sort="' + key + '"' + ariaSort(key) + (cls ? ' class="' + cls + '"' : '') + '><a class="tprm-sort" href="' + sortHref(key).replace(/&/g, '&amp;') + '">' + label + '</a></th>';
  const tierRank = { critical: 1, high: 2, medium: 3, low: 4 };
  const statusRank = { proposed: 1, in_use: 2, exited: 3 };
%>
<%- include('tprm_client_nav', { tpClient, section: isDueView ? 'due' : 'register', canManage, canSettings, dueCount: list.counts.due,
  primaryAction: canManage ? { href: '/tprm/clients/' + tpClient.id + '/third-parties/new', label: 'Add third party' } : null }) %>
<%- include('tprm_client_concentration_link') %>
<% if (typeof clientRequestsOpen !== 'undefined' && clientRequestsOpen.length) { %>
<div class="panel" data-tprm-client-requests>
  <div class="panel-head"><h2>Requests from the client</h2><span class="meta"><%= clientRequestsOpen.length %></span></div>
  <div class="table-scroll"><table class="t"><thead><tr><th>Supplier</th><th>Service</th><th>Asked by</th><th>Sent</th><th></th></tr></thead><tbody>
  <% clientRequestsOpen.forEach(r => { %><tr data-tprm-client-request="<%= r.id %>"><td><strong><%= r.name %></strong></td><td><%= r.service_description %></td><td><%= r.requested_by_name || '-' %></td>
    <td><%= tpf.day(new Date(r.requested_at).toISOString().slice(0, 10)) %></td><td class="tprm-right"><a class="btn btn-secondary btn-xs" href="/tprm/clients/<%= tpClient.id %>/requests/<%= r.id %>">Open</a></td></tr><% }) %>
  </tbody></table></div>
</div>
<% } %>

<div class="panel" data-tprm-register data-tprm-view="<%= f.view %>">
  <div class="panel-head">
    <h2><%= isDueView ? 'Due for reassessment' : 'Register' %></h2>
    <span class="meta" data-tp-list-count data-tp-total="<%= list.counts.total %>">Showing <%= list.rows.length %> of <%= list.counts.total %></span>
  </div>
  <% if (isDueView) { %>
    <div class="panel-pad meta tprm-divide-b">Start a reassessment for each third party below, oldest first.
      <details class="tprm-how"><summary>How this works</summary>Listed: third parties in use whose next due date is today (<%= tpf.day(list.today) %>) or earlier, or that have no due date yet.</details></div>
  <% } %>
  <form method="GET" action="/tprm/clients/<%= tpClient.id %>" class="panel-pad tprm-filters tprm-divide-b" data-tprm-filters data-tp-list-controls>
    <% if (isDueView) { %><input type="hidden" name="view" value="due"><% } %>
    <% if (f.sort) { %><input type="hidden" name="sort" value="<%= f.sort %>"><input type="hidden" name="dir" value="<%= f.dir %>"><% } %>
    <div><label class="label" for="f-q">Search</label>
      <input class="input" id="f-q" type="search" name="q" value="<%= f.q %>" placeholder="Name, category or client label" autocomplete="off" data-tp-list-search data-tprm-register-search></div>
    <% if (!isDueView) { %>
    <div><label class="label" for="f-status">Status</label>
      <select class="select" id="f-status" name="status">
        <option value="">Current (not exited)</option>
        <option value="all" <%= f.status === 'all' ? 'selected' : '' %>>All, including exited</option>
        <% tp.STATUSES.forEach(s => { %><option value="<%= s %>" <%= f.status === s ? 'selected' : '' %>><%= tp.STATUS_LABELS[s] %></option><% }) %>
      </select></div>
    <% } %>
    <div><label class="label" for="f-tier">Tier</label>
      <select class="select" id="f-tier" name="tier">
        <option value="">Any tier</option>
        <% tp.TIERS.forEach(t => { %><option value="<%= t %>" <%= f.tier === t ? 'selected' : '' %>><%= tp.TIER_LABELS[t] %></option><% }) %>
        <option value="none" <%= f.tier === 'none' ? 'selected' : '' %>>Tier needed</option>
      </select></div>
    <% if (!isDueView) { %>
    <div><label class="label" for="f-due">Due</label>
      <select class="select" id="f-due" name="due">
        <option value="">Any</option>
        <option value="due" <%= f.due === 'due' ? 'selected' : '' %>>Due or overdue</option>
        <option value="upcoming" <%= f.due === 'upcoming' ? 'selected' : '' %>>Due in the next <%= list.upcomingDays %> days</option>
        <option value="not_due" <%= f.due === 'not_due' ? 'selected' : '' %>>Not due</option>
      </select></div>
    <% } %>
    <button class="btn btn-secondary btn-xs" type="submit">Apply</button>
    <% if (f.status || f.tier || f.due || f.q || f.sort) { %><a class="btn btn-ghost btn-xs" href="/tprm/clients/<%= tpClient.id %><%= isDueView ? '?view=due' : '' %>" data-tprm-clear-filters>Clear</a><% } %>
  </form>

  <% if (!list.rows.length) { %>
    <div class="empty-state" data-tprm-register-empty>
      <% if (!list.counts.total) { %>
        <div class="empty-title">No third parties yet</div>
        <div class="meta"><% if (canManage) { %>Add a third party, or <a href="/tprm/clients/<%= tpClient.id %>/import">import the client's list from a CSV file</a>.<% } else { %>The consulting team has not added any third parties for this client.<% } %></div>
      <% } else { %>
        <div class="empty-title"><%= isDueView && !f.q ? 'Nothing is due for reassessment' : f.q ? 'No third party matches "' + f.q + '"' : 'No third party matches these filters' %></div>
        <% if (!isDueView && !f.status && list.counts.exited) { %><div class="meta" data-tprm-exited-hidden><%= list.counts.exited %> exited third part<%= list.counts.exited === 1 ? 'y is' : 'ies are' %> hidden. <a href="/tprm/clients/<%= tpClient.id %><%= qs({ status: 'all', tier: f.tier, due: f.due }) %>">Show all</a></div><% } %>
      <% } %>
    </div>
  <% } else { %>
    <div class="table-scroll">
    <table class="t tprm-register-table" data-tprm-register-table data-tp-list>
      <thead><tr>
        <%- sortTh('name', 'Third party') %><%- sortTh('status', 'Status') %><%- sortTh('tier', 'Tier') %>
        <th>Assessment</th>
        <th>Client decision</th>
        <%- sortTh('last_assessed', 'Last assessed') %><%- sortTh('next_due', 'Next due') %><%- sortTh('services', 'Services', 'tprm-right') %>
      </tr></thead>
      <tbody>
      <% list.rows.forEach(r => { %>
        <tr data-tprm-row="<%= r.id %>" data-tp-row data-tp-text="<%= [r.name, r.legal_name, r.category, r.client_label].filter(Boolean).join(' ').toLowerCase() %>"
          data-tp-sort-name="<%= String(r.name || '').toLowerCase() %>" data-tp-sort-status="<%= statusRank[r.status] || 9 %>" data-tp-sort-tier="<%= tierRank[r.current_tier] || 5 %>"
          data-tp-sort-last_assessed="<%= tpf.ymd(r.last_assessment_date) %>" data-tp-sort-next_due="<%= tpf.ymd(r.next_due_date) %>" data-tp-sort-services="<%= r.service_count %>">
          <td><a href="/tprm/clients/<%= tpClient.id %>/third-parties/<%= r.id %>"><%= r.name %></a>
            <% if (r.category || r.client_label) { %><div class="meta text-xs"><%= [r.category, r.client_label ? 'Client label: ' + r.client_label : null].filter(Boolean).join(' · ') %></div><% } %></td>
          <td><%= tp.STATUS_LABELS[r.status] %></td>
          <td><% if (r.current_tier) { %><%= tp.TIER_LABELS[r.current_tier] %>
              <% if (r.tier_source === 'provisional_from_client_label') { %><span class="meta text-xs">provisional</span><% } %>
            <% } else { %><%- include('partials/tprm_status', { text: tpLabels.TIER_NEEDED, tone: 'attention' }) %><% } %></td>
          <% const stg = typeof stages !== 'undefined' && stages ? stages.get(Number(r.id)) : null; %>
          <td<%- stg ? ' data-tprm-register-stage="' + stg.stepKey + '" data-tprm-register-waiting="' + stg.waiting + '"' : '' %>><% if (stg) { %><a href="/tprm/clients/<%= tpClient.id %>/third-parties/<%= r.id %>/assessments/<%= stg.assessmentId %>"><%= stg.step %></a><span class="meta text-xs tprm-block">Waiting on: <%= stg.waitingLabel.toLowerCase() %><%= stg.waitingName ? ', ' + stg.waitingName : '' %></span><% } else { %><span class="meta">None open</span><% } %></td>
          <% const ap = typeof approvals !== 'undefined' ? approvals.get(Number(r.id)) : null; %>
          <td data-tprm-approval="<%= ap ? ap.state : '' %>"><% if (ap) { %>
            <%- include('partials/tprm_status', { text: ap.label, tone: ap.tone, as: 'div' }) %>
            <% if (ap.pending) { %><%- include('partials/tprm_status', { text: tpLabels.pending(ap.pending, 'firm'), tone: ap.pendingTone, as: 'div', attrs: 'data-tprm-pending="' + ap.pending + '"' }) %><% } %>
            <% if (ap.conditions) { %><%- include('partials/tprm_status', { text: ap.conditions.label, tone: ap.conditions.state === 'overdue' ? 'problem' : ap.conditions.state === 'met' ? 'good' : 'quiet', as: 'div', attrs: 'data-tprm-conditions-state="' + ap.conditions.state + '"' }) %><% } %>
          <% } %></td>
          <td><%= tpf.day(r.last_assessment_date) || '-' %></td>
          <% const dl = r.status === 'in_use' ? tpLabels.due({ nextDueDate: r.next_due_date, lastAssessmentDate: r.last_assessment_date, inProgress: !!(ap && ap.openAssessment), today: list.today }) : null; %>
          <td><% if (dl && (r.due || dl.label)) { %><%- include('partials/tprm_status', { text: dl.label || 'No due date', tone: dl.tone, attrs: (r.due ? 'data-tprm-due ' : '') + 'data-tprm-due-state="' + dl.key + '"' }) %>
            <% } else { %><%= tpf.day(r.next_due_date) || '-' %><% } %></td>
          <td class="num tprm-right"><%= r.service_count %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
    <% if (!isDueView && !f.status && list.counts.exited) { %>
      <div class="panel-pad meta text-xs tprm-divide" data-tprm-exited-hidden><%= list.counts.exited %> exited third part<%= list.counts.exited === 1 ? 'y is' : 'ies are' %> hidden. <a href="/tprm/clients/<%= tpClient.id %><%= qs({ status: 'all', tier: f.tier, due: f.due }) %>">Show all</a></div>
    <% } %>
  <% } %>
</div>
<%- include('partials/footer') %>
