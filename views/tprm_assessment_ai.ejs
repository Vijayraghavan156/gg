<%
  const ap = aiPanel;
  const aiBase = '/tprm/clients/' + tpClient.id + '/third-parties/' + thirdParty.id + '/assessments/' + assessment.id;
  const aiCsrf = typeof csrfToken !== 'undefined' ? csrfToken : '';
  const aiWhen = d => tpf.dayTime(d) || '-';
  const runTone = s => ({ succeeded: 'good', failed: 'problem' })[s] || 'quiet';
%>
<div class="tpw-ailine" id="ai-review" data-tprm-ai-review>
  <div class="tpw-ailine-row">
    <p class="tpw-ailine-text" data-tprm-ai-summary>
      <b>Brevis</b>
      <% if (!ap.configured) { %><span data-tprm-ai-not-configured><%= String(ap.notConfiguredMessage).replace(/^Brevis\s+/, '') %> Runs are recorded as "Not set up" and nothing is sent anywhere.</span>
      <% } else if (ap.active) { %><span data-tprm-ai-active="<%= ap.active.status %>"><%= ap.statusLabels[ap.active.status] %>, requested <%= aiWhen(ap.active.created_at) %>. Reload the page in a minute to see its suggestions.</span>
      <% } else if (!ap.latest) { %><span data-tprm-ai-suggestions-empty>has not reviewed this assessment yet.</span>
      <% } else { const toDecide = ap.pendingConclusions + ap.pendingFindings; %>finished <%= aiWhen(ap.latest.finished_at) %>.
        <span class="meta" data-tprm-ai-to-decide="<%= toDecide %>"><% if (!ap.pendingCount && !ap.groups.length) { %><span data-tprm-ai-suggestions-empty>The latest run made no suggestions.</span><% } else if (!toDecide) { %>Every suggestion on the answers is decided.<% } else { %><%= toDecide %> suggestion<%= toDecide === 1 ? '' : 's' %> to decide<%= ap.pendingConclusions && ap.pendingFindings ? ': ' + ap.pendingConclusions + ' conclusion' + (ap.pendingConclusions === 1 ? '' : 's') + ' and ' + ap.pendingFindings + ' finding' + (ap.pendingFindings === 1 ? '' : 's') : (ap.pendingFindings ? ', all findings' : ', all conclusions') %>. Each one is shown on its answer below.<% } %></span>
      <% } %>
      <span class="meta" data-tprm-ai-provider-note><% if (ap.configured) { %><%= ap.provider %>, <%= ap.model %>.<% } %></span>
    </p>
    <details class="tprm-how tpw-ailine-how"><summary>How this works</summary>
      <div>Firm-internal: the client never sees these suggestions. A suggestion becomes a finding, or an answer's reviewer conclusion, only when a consultant accepts it.<% if (ap.autoReview) { %> It runs automatically when the third party submits its questionnaire.<% } else { %> The firm has switched the automatic review off: run it by hand.<% } %></div>
      <div class="tpu-mt-4" data-tprm-ai-run-note>
        <% if (ap.blocked) { %><span data-tprm-ai-blocked><%= ap.blocked %></span><% } else if (ap.active) { %>A review is already waiting or running.<% } else if (ap.limitReached) { %><span data-tprm-ai-limit><%= ap.limitMessage %><% if (ap.nextRunAt) { %> The next run is possible from <%= aiWhen(ap.nextRunAt) %>.<% } %></span><% } else if (ap.runs.length) { %>Running again replaces the suggestions you have not decided on yet.<% } %>
        <% if (ap.configured) { %><span data-tprm-ai-recent> Runs in the last 24 hours: <%= ap.recentRuns %> of <%= ap.limits.runsPerDay %>.</span><% } %>
      </div>
    </details>
    <% if (ap.canRun) { %>
      <form method="POST" action="<%= aiBase %>/ai-review" class="tpw-ailine-run" data-tprm-ai-run-form>
        <input type="hidden" name="_csrf" value="<%= aiCsrf %>">
        <% if (ap.needsOverride) { %>
          <input name="override_reason" required maxlength="<%= ap.limits.overrideReason %>" placeholder="Reason to run past the limit" class="input tprm-ai-override-input" aria-label="Why run Brevis past the limit" data-tprm-ai-override-reason>
          <button class="btn btn-secondary btn-xs" type="submit" data-tprm-ai-run>Run anyway</button>
        <% } else { %>
          <button class="btn btn-secondary btn-xs" type="submit" data-tprm-ai-run><%= ap.runs.length ? 'Run Brevis again' : 'Run Brevis' %></button>
        <% } %>
      </form>
    <% } %>
  </div>

  <% if (ap.superseded) { %><p class="meta text-xs" data-tprm-ai-superseded><%= ap.superseded %> suggestion<%= ap.superseded === 1 ? '' : 's' %> of earlier runs were not decided and were replaced by a later run.</p><% } %>

  <% if (ap.runs.length) { %>
    <details class="tpw-ailine-runs" data-tprm-ai-runs>
      <summary>Runs <span class="meta"><%= ap.runs.length %></span></summary>
      <div class="table-scroll"><table class="t">
        <thead><tr><th>Requested</th><th>By</th><th>Status</th><th>Model</th><th>Input</th><th>Suggestions</th></tr></thead>
        <tbody>
        <% ap.runs.forEach(r => { const sm = r.input_summary || {}; %>
          <tr data-tprm-ai-run-row="<%= r.id %>" data-tprm-ai-run-status="<%= r.status %>">
            <td class="meta text-xs"><%= aiWhen(r.created_at) %></td>
            <td class="text-xs"><%= r.run_trigger === 'manual' ? (r.requested_by_name || 'Unknown user') : 'Automatic, on submission' %><% if (r.override_reason) { %><div class="meta text-xs" data-tprm-ai-run-override>Past the limit: <%= r.override_reason %></div><% } %></td>
            <td><%- include('partials/tprm_status', { text: ap.statusLabels[r.status], tone: runTone(r.status) }) %><% if (r.error) { %><div class="meta text-xs" data-tprm-ai-run-error><%= r.error %><% if (r.refusal_category) { %> (category: <%= r.refusal_category %>)<% } %></div><% } %></td>
            <td class="meta text-xs"><%= r.provider ? ({ anthropic: 'Anthropic', openrouter: 'OpenRouter' }[r.provider] || r.provider) + ' · ' + r.model : '-' %><% if (r.served_model && r.served_model !== r.model) { %><div data-tprm-ai-run-served>Answered by <%= r.served_model %></div><% } %></td>
            <td class="meta text-xs"><% if (r.input_sha256) { %><%= sm.answers || 0 %> answers, <%= sm.files_read || 0 %> files sent<% if (sm.files_attached) { %> (<%= sm.files_attached %> as files<% if (sm.pdf_pages_attached) { %>, <%= sm.pdf_pages_attached %> PDF pages<% } %>)<% } %><% if (sm.files_listed_by_name_only) { %>, <%= sm.files_listed_by_name_only %> by name only<% } %><% if (sm.files_truncated) { %>, <%= sm.files_truncated %> cut short<% } %><div title="sha256 of what was sent">sha256 <%= r.input_sha256.slice(0, 12) %><% if (r.retry_input_sha256) { %>, retry <%= r.retry_input_sha256.slice(0, 12) %><% } %></div><% } else { %>-<% } %></td>
            <td class="meta text-xs"><% if (r.status === 'succeeded') { %><%= r.suggestion_count %><% if (r.dropped_count) { %> (<%= r.dropped_count %> dropped as invalid)<% } %><% } else { %>-<% } %></td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
    </details>
  <% } %>
</div>
