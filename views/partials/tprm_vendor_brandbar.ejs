<div class="vq-brandbar" data-vendor-brandbar="<%= firm && firm.name ? 'firm' : 'plain' %>">
  <div class="vq-wrap vq-brandbar-inner">
    <% if (firm && firm.logo) { %><img class="vq-brand-logo" src="<%= firm.logo %>" alt="<%= firm.name || '' %>"><% } %>
    <% if (firm && firm.name) { %><span class="vq-brand-name<%= firm.logo ? ' vq-brand-name--with-logo' : '' %>" data-vendor-firm><%= firm.name %></span><% } %>
  </div>
</div>
