<nav class="tprm-home-tabs" aria-label="Third-party risk" data-tprm-home-tabs>
  <% const tabs = [['pipeline', '/tprm', 'Pipeline', ''], ['review', '/tprm/review', 'Review queue' + (typeof locals.reviewCount === 'number' ? ' (' + locals.reviewCount + ')' : ''), 'data-tprm-review-link'], ['out', '/tprm/questionnaires', 'Questionnaires out', 'data-tprm-out-link'], ['due', '/tprm/due', 'Reassessments due', 'data-tprm-due-link'], ['conditions', '/tprm/conditions', 'Conditions due', 'data-tprm-conditions-link']]; %>
  <% tabs.forEach(([key, href, label, hook]) => { %><% if (key === locals.current) { %><strong class="tprm-home-tab is-current" aria-current="page"<%- hook ? ' ' + hook : '' %>><%= label %></strong><% } else { %><a class="tprm-home-tab" href="<%= href %>"<%- hook ? ' ' + hook : '' %>><%= label %></a><% } %><% }) %>
</nav>
