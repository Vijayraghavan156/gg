<%
  const ctx = p.ctx;
  const base = locals.base || ('/vendor/q/' + token);
  const fmtDay = d => (d ? tpf.day(d) : '');
  const fmtWhen = d => (d ? tpf.dayTime(d, { zone: true }) : '');
  const today = tpf.today;
  const errorList = (errors || []).map(e => (e && typeof e === 'object' ? e : { id: null, message: String(e) }));
  const errorsFor = id => errorList.filter(e => e.id === id);
  const sizeOf = n => tpf.fileSize(n);
  const allQuestions = p.sections.flatMap(s => s.questions);
  const questionText = id => { const q = allQuestions.find(x => x.id === id); return q ? q.question : ''; };
  const sectionHref = (n, anchor) => base + '?s=' + n + (anchor ? '#' + anchor : '');
  const onSection = view === 'section' && !!section && ctx.mode === 'answering';
  const FORM_ID = 'vq-answer-form';
  const goValue = s => (s && s.questions && s.questions[0] ? s.questions[0].id : null);
  const openClarifications = p.clarifications.filter(c => c.status === 'open');
  const answeredClarifications = p.clarifications.filter(c => c.status === 'answered');
  const pct = p.total ? Math.round((p.answered / p.total) * 100) : 0;
  const answering = ctx.mode === 'answering';
  const firstOpen = p.sections.find(s => !s.complete) || null;
  const started = p.responded > 0;
  const fileMb = p.limits.fileBytes / 1048576;
  const plural = (n, one, many) => n + ' ' + (n === 1 ? one : (many || one + 's'));
  const rv = reportValues || null;
  const rvFor = kind => (rv && rv.kind === kind ? rv : null);
  const titleOf = view === 'section' && section ? section.title : view === 'confirm' ? 'Review and submit' : view === 'documents' ? 'Your documents' : view === 'clarify' ? 'Questions from the reviewers' : 'Overview';
  const firmName = p.firm.name || 'the review team';
  const listWords = items => (items.length < 2 ? items.join('') : items.slice(0, -1).join(', ') + ' and ' + items[items.length - 1]);
  const docCount = p.documentsNeeded.reduce((n, g) => n + g.documents.length, 0);
  const shelfFor = q => p.shelf.filter(d => !q.files.some(f => f.id === d.id));
  const reviewer = ctx.issuer ? (ctx.issuer.name ? ctx.issuer.name + ' (' + ctx.issuer.email + ')' : ctx.issuer.email) : null;
  const commentWho = (p.firm.name ? 'The reviewers at ' + p.firm.name : 'The reviewers') + ' see your comment once you save. Replies come by email from ' + (reviewer ? 'your reviewer, ' + reviewer : 'your reviewer') + '.';
  const ANSWER_STYLE = 'vq-seg';
  const brandName = p.firm.name || (frame && frame.firm && frame.firm.name) || '';
  const expYmd = ctx.expiresAt ? tpf.ymd(ctx.expiresAt) : '';
  const daysLeft = expYmd && today ? Math.round((Date.parse(expYmd) - Date.parse(today)) / 86400000) : null;
  const daysText = daysLeft == null ? '' : daysLeft > 1 ? daysLeft + ' days left' : daysLeft === 1 ? '1 day left' : daysLeft === 0 ? 'last day' : '';
  const ready = !p.problems.length;
  const reviewerName = ctx.issuer ? (ctx.issuer.name || ctx.issuer.email) : null;
  const askerOf = c => c.asked_by_name || (p.firm.name ? 'The reviewers at ' + p.firm.name : 'The reviewers');
  const firstName = n => String(n || '').split(' ')[0];
  const extOf = name => { const m = /\.([A-Za-z0-9]{1,5})$/.exec(String(name || '')); return m ? m[1].toUpperCase() : 'FILE'; };
  const usedIn = (qid, fid) => allQuestions.filter(x => x.id !== qid && x.files.some(f => f.id === fid)).map(x => x.id);
  const onShelf = fid => p.shelf.some(d => d.id === fid);
  const isOpenQ = q => q.asked && q.rules.required !== false && !(q.answer && q.answer.response);
  const guidanceHtml = g => { const m = /^A good answer includes:?\s*([\s\S]*)$/.exec(g || ''); return m ? '<b>A good answer includes</b> ' + attrText(m[1]) : attrText(g); };
  function attrText(v) { return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
  const infoIcon = '<svg class="vq-i" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M17 22v-8h-4v2h2v6h-3v2h8v-2zM16 8a1.5 1.5 0 101.5 1.5A1.5 1.5 0 0016 8z"/><path d="M16 30a14 14 0 1114-14 14 14 0 01-14 14zm0-26a12 12 0 1012 12A12 12 0 0016 4z"/></svg>';
  const downloadIcon = '<svg class="vq-i" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M26 24v4H6v-4H4v4a2 2 0 002 2h20a2 2 0 002-2v-4zM26 14l-1.41-1.41L17 20.17V2h-2v18.17l-7.59-7.58L6 14l10 10 10-10z"/></svg>';
  const commentIcon = '<svg class="vq-i" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M17.74 30L16 29l4-7h6a2 2 0 002-2V8a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2h9v2H6a4 4 0 01-4-4V8a4 4 0 014-4h20a4 4 0 014 4v12a4 4 0 01-4 4h-4.84z"/></svg>';
%><!doctype html>
<html lang="en" class="page-standalone" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <link rel="stylesheet" href="/app.css">
<%- include('tprm_portal_head', { title: 'Questionnaire for ' + ctx.clientName + ' · ' + titleOf, frame, withScript: true, qframe: true }) %>
</head>
<body class="vq-body vq-c">
  <a class="vq-skip" href="#main">Skip to the content</a>
  <% if (locals.firmEntry) { %><div class="vq-firm-entry" role="note" data-vendor-firm-entry>You are entering answers for the third party, as <%= firmEntry.name %>. Each answer you save shows that you entered it. <a href="<%= firmEntry.back %>?step=questionnaire#questionnaire">Back to the assessment</a></div><% } %>
  <% const attr = v => String(v).replace(/&/g, '&amp;').replace(/"/g, '&#34;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
     const sectionNav = answering ? include('partials/tprm_vendor_qmenu', { p, ctx, base, view, section, formId: onSection ? FORM_ID : null, contractInfo: locals.contractInfo || null, issueCount: locals.issueCount || null, assigned: locals.assigned || null, signedIn: locals.signedIn || null }) : '';
     const meta = [];
     if (ctx.expiresAt) meta.push('<span class="vq-due" data-vendor-deadline>Due <strong>' + attr(fmtDay(ctx.expiresAt)) + '</strong>' + (daysText ? ' · ' + daysText : '') + '</span>');
     if (ctx.issuer) meta.push('<span data-vendor-reviewer>Reviewer <a href="mailto:' + attr(ctx.issuer.email) + '"><strong>' + attr(reviewerName) + '</strong></a>' + (brandName ? ', ' + attr(brandName) : '') + '</span>');
     if (view === 'start' && ctx.recipientName && !(frame && frame.me)) meta.push('<span>Sent to <span data-vendor-recipient>' + attr(ctx.recipientName) + '</span></span>');
     let actions = '';
     if (answering) {
       actions += '<a class="vq-btn vq-btn--band" href="' + attr(base) + '/spreadsheet" data-vendor-toolbar-excel>' + downloadIcon + 'Excel</a>';
       if (view !== 'confirm') {
         if (!ready) actions += '<button class="vq-btn vq-btn--band-main" type="button" disabled title="Submit opens once every required answer is in" aria-describedby="vq-submit-why" data-vendor-toolbar-submit>Submit</button><span class="sr-only" id="vq-submit-why">Submit opens once every required answer is in.</span>';
         else if (onSection) actions += '<button class="vq-btn vq-btn--band-main" type="submit" form="' + FORM_ID + '" name="go" value="review" formnovalidate data-vendor-toolbar-submit>Submit</button>';
         else actions += '<a class="vq-btn vq-btn--band-main" href="' + attr(base) + '?view=review" data-vendor-toolbar-submit>Submit</a>';
       }
     }
     const curMark = view === 'section' && section ? (section.complete ? 'done' : section.responded ? 'part' : 'none') : null;
     const pickerHtml = view === 'section' && section
       ? '<span class="vq-picker-mark" data-vq-mark="' + curMark + '"></span><span class="vq-picker-title">' + attr(section.title) + '</span><span class="vq-picker-of">' + section.index + ' of ' + p.sections.length + '</span>'
       : '<span class="vq-picker-title">' + attr(titleOf) + '</span>';
     const showRail = !!ctx; %>
  <% if (onSection) { %>
    <button type="submit" form="<%= FORM_ID %>" name="intent" value="save" class="vq-default-submit" tabindex="-1" aria-hidden="true" data-vendor-default-submit>Save</button>
  <% } %>
  <%- include('partials/tprm_vq_top', { frame, band: {
        eyebrow: [frame && frame.orgName, locals.reviewName].filter(Boolean).join(' · '),
        h1Attrs: ' data-vendor-cover-title',
        titleHtml: 'Security questionnaire for <span data-vendor-client>' + attr(ctx.clientName) + '</span>',
        metaHtml: meta,
        progress: answering ? { answered: p.answered, total: p.total } : null,
        actionsHtml: actions,
        savedHtml: answering ? '<span data-vendor-last-saved>' + attr(p.lastSavedAt ? 'Saved ' + fmtWhen(p.lastSavedAt) : 'Nothing saved yet') + '</span>' : '',
      } }) %>
  <div class="vq-frame<%= showRail ? ' has-rail' : '' %>">
    <%- include('partials/tprm_portal_side', { frame, formId: onSection ? FORM_ID : null, extraHtml: sectionNav, cframe: true, pickerHtml, pickerNow: titleOf }) %>

    <main class="vq-main <%= ANSWER_STYLE %>" id="main" data-vendor-link-open data-vendor-mode="<%= ctx.mode %>" data-vendor-view="<%= view %>">
      <% if (notice) { %>
        <p class="vq-notice" role="status" data-vendor-notice><%= notice %></p>
      <% } %>
      <% if (errorList.length) { %>
        <div class="vq-errors" role="alert" data-vendor-errors>
          <p class="vq-errors-title">Nothing was saved. Correct the following:</p>
          <ul>
            <% errorList.forEach(e => { const inHere = view === 'section' && section && section.questions.some(q => q.id === e.id); %><li><% if (e.id) { %><a href="<%= inHere ? '' : sectionHref(p.sectionOf.get(e.id) || 1) %>#<%= e.field ? 'f-' + e.id + '-' + e.field : 'q-' + e.id %>"><%= e.id %></a>: <% } %><%= e.message %></li><% }) %>
          </ul>
        </div>
      <% } %>

      <% if (view === 'clarify' || openClarifications.length || answeredClarifications.length) { %>
        <section class="vq-page vq-card" aria-labelledby="clarifications-title" data-vendor-clarifications>
          <header class="vq-card-head">
            <h2 class="vq-page-title" id="clarifications-title">Questions from the reviewers</h2>
            <% if (openClarifications.length) { %>
              <p class="vq-lead">The reviewers need more information about these answers. Each response is sent on its own.</p>
              <p class="vq-note" data-vendor-asked-banner><%= openClarifications.length === 1 ? askerOf(openClarifications[0]) + ' asked about ' + openClarifications[0].question_id : 'The reviewers asked about ' + plural(openClarifications.length, 'answer') %>. Reply below.</p>
            <% } %>
          </header>
          <% openClarifications.forEach(c => { %>
            <form method="POST" action="<%= base %>/clarifications/<%= c.id %>" enctype="multipart/form-data" class="vq-item vq-clar" data-vendor-clarification="<%= c.id %>">
              <input type="hidden" name="_aft" value="<%= aft %>">
              <p class="vq-item-ref">Question <%= c.question_id %><% if (c.raised_for) { %>. <span data-vendor-clarification-document>A document is needed.</span><% } %></p>
              <p class="vq-item-text"><%= c.question %></p>
              <% if (c.answer && c.answer.response) { %><p class="vq-item-sub vq-pre" data-vendor-clarify-answer>Your answer: <%= c.answerText ? c.answerText : p.responseLabels[c.answer.response] + (c.answer.detail ? ': ' + c.answer.detail : '') %></p><% } %>
              <div class="vq-thread">
                <p class="vq-thread-head"><strong><%= askerOf(c) %></strong> <span class="vq-thread-when"><%= c.asked_by_name && brandName ? brandName + ' reviewer · ' : '' %>asked on <%= fmtDay(c.asked_at) %></span><span class="vq-thread-tag">Awaiting your reply</span></p>
                <p class="vq-item-quote vq-pre vq-thread-body"><%= c.body %></p>
                <div class="vq-field">
                  <label class="vq-label" for="cr-<%= c.id %>">Your response</label>
                  <textarea class="vq-input vq-textarea" id="cr-<%= c.id %>" name="response" rows="3" maxlength="<%= p.limits.response %>" required<% if (c.asked_by_name) { %> placeholder="Reply to <%= firstName(c.asked_by_name) %>"<% } %>></textarea>
                </div>
                <div class="vq-field">
                  <label class="vq-label" for="cf-<%= c.id %>">Attach a file <span class="vq-optional">optional, up to <%= fileMb %> MB</span></label>
                  <input class="vq-file-input" id="cf-<%= c.id %>" type="file" name="file">
                </div>
                <div class="vq-form-foot"><button class="vq-btn vq-btn--secondary" type="submit" data-vendor-clarification-send>Send response</button></div>
              </div>
            </form>
          <% }) %>
          <% answeredClarifications.forEach(c => { %>
            <div class="vq-item vq-clar" data-vendor-clarification-answered="<%= c.id %>">
              <p class="vq-item-ref">Question <%= c.question_id %>. Response sent; waiting for the reviewers.</p>
              <p class="vq-item-text"><%= c.question %></p>
              <div class="vq-thread vq-thread--done">
                <p class="vq-item-label">The reviewers asked</p>
                <p class="vq-item-quote vq-pre"><%= c.body %></p>
                <p class="vq-item-label">You responded on <%= fmtDay(c.responded_at) %></p>
                <p class="vq-item-quote vq-pre"><%= c.response %></p>
                <% if (c.response_file_name) { %><p class="vq-item-sub">File: <span class="vq-file-name"><%= c.response_file_name %></span></p><% } %>
              </div>
            </div>
          <% }) %>
          <% if (!answering && locals.issueCount && issueCount.total) { %>
            <p class="vq-item" data-vendor-issues-link>The reviewers have shared <%= plural(issueCount.total, 'issue') %> with you<%= issueCount.waiting ? ', ' + issueCount.waiting + ' waiting for your response' : '' %>. <a href="<%= base %>/issues">Open the issues</a>.</p>
          <% } %>
          <% if (view === 'clarify' && !openClarifications.length) { %>
            <div class="vq-item" data-vendor-nothing-to-do>
              <p class="vq-item-text">Nothing to answer right now</p>
              <p class="vq-muted">Your questionnaire has been submitted. There is nothing for you to answer at the moment.</p>
            </div>
          <% } %>
        </section>
      <% } %>

      <% if (view === 'start' && answering) { const n = p.counts; %>
        <div class="vq-card vq-card--start">
        <section class="vq-start" aria-labelledby="start-title" data-vendor-start-page>
          <header class="vq-card-head"><p class="vq-section-where">Before you start</p><h2 class="vq-section-title" id="start-title">Overview</h2></header>
          <p class="vq-start-lead" data-vendor-start-count><%= plural(p.total, 'question') %> in <%= plural(p.sections.length, 'section') %>. Answer them in any order, then submit once every required answer is in.</p>
          <% const asked = ['iso27001', 'soc2_type2'].filter(k => p.reports.inQuestions[k]); if (asked.length && !p.coveredDocuments) { const sIdx = p.reports.questionSection[asked[0]];
               const soaWhere = p.reports.soaOnExtra ? 'as a second file on ASR-01, or on ASR-02' : 'as a second file on ASR-01';
               const tipFor = k => k === 'iso27001'
                 ? 'a current ISO 27001 certificate, answer ASR-01 with the certificate and your Statement of Applicability attached (' + soaWhere + '): together they cover the documents for ' + plural(p.reports.others[k], 'other question')
                 : 'a current SOC 2 Type II report, answer ASR-03 with the report attached and its period end date: it covers the documents for ' + plural(p.reports.others[k], 'other question'); %><p class="vq-start-note" data-vendor-report-hint>If you hold <%= asked.map(tipFor).join('. If you hold ') %>. Answer <%= asked.length > 1 ? 'them' : 'it' %> first in <a href="<%= sectionHref(sIdx) %>"><%= p.sections[sIdx - 1].title %></a>. Naming a document is not enough here: the files are needed.</p><% } %>
          <% if (p.coveredDocuments) { %><p data-vendor-report-covered>Your certificate or report covers the documents for <%= plural(p.coveredDocuments, 'question') %>, so they need none of their own.</p><% } %>
          <% if (p.lastTime) { %><p class="vq-start-note" data-vendor-last-time-note>Some answers are filled in from your answers of <%= fmtDay(p.lastTime) %>, marked "From last time". Confirm each one is still correct, or change it.</p><% } %>
          <% if (locals.contractInfo && contractInfo) { %><p class="vq-start-note" data-vendor-contract-note>Also tell us which <a href="<%= base %>/contract">contract clauses</a> your contract with <%= ctx.clientName %> has: <%= contractInfo.answered %> of <%= contractInfo.total %> marked so far.</p><% } %>
          <% if (p.aiAddedByAnswer) { %><p class="vq-start-note" id="ai-services">An <strong>AI Services</strong> section has been added because you answered Yes to AIS-01.</p><% } %>
          <% if (p.sections.length) { %>
          <div class="vq-actions vq-actions--start">
            <form method="GET" action="<%= base %>" class="vq-jump" data-vendor-jump>
              <label class="sr-only" for="vq-jump">Go to a section</label>
              <select class="vq-input vq-jump-select" id="vq-jump" name="s">
                <option value="" selected disabled>Go to a section</option>
                <% p.sections.forEach(x => { %><option value="<%= x.index %>"><%= 'Section ' + x.index + ' of ' + p.sections.length + ': ' + x.title %></option><% }) %>
              </select>
              <button class="vq-btn vq-btn--secondary vq-jump-go" type="submit" data-vendor-jump-go>Go</button>
            </form>
            <span class="vq-actions-gap"></span>
            <a class="vq-btn vq-btn--primary" href="<%= sectionHref(started && firstOpen ? firstOpen.index : 1) %>" data-vendor-start><%= started ? (firstOpen ? 'Continue where you left off' : 'Go to the questions') : 'Start the questionnaire' %></a>
          </div>
          <% } %>
        </section>

        <% if (locals.assigned && locals.colleagues && colleagues.length > 1 && p.sections.length) { const isMain = signedIn.role === 'main'; %>
          <section class="vq-page vq-page--follow vq-card-part" id="who-answers" aria-labelledby="who-title" data-vendor-who-answers>
            <h2 class="vq-h2" id="who-title">Who answers each section</h2>
            <p class="vq-lead"><%= isMain ? 'Colleagues are emailed the sections you give them. Anyone can still answer any section.' : 'Chosen by the main contact. Anyone can answer any section.' %></p>
            <% if (isMain) { %>
              <form method="POST" action="<%= base %>/assign" data-vendor-assign-form>
                <input type="hidden" name="_aft" value="<%= aft %>">
                <div class="vq-panel"><table class="vq-table">
                  <thead><tr><th scope="col">Section</th><th scope="col">Answered by</th></tr></thead>
                  <tbody>
                  <% p.sections.forEach(s => { const cur = assigned.get(s.title); %>
                    <tr><td><label for="as-<%= s.index %>"><%= s.title %></label></td>
                      <td><select class="vq-input" id="as-<%= s.index %>" name="assign[<%= s.title %>]">
                        <option value="">Anyone</option>
                        <% colleagues.forEach(c => { %><option value="<%= c.id %>"<%= cur && cur.personId === Number(c.id) ? ' selected' : '' %>><%= c.name %><%= Number(c.id) === signedIn.id ? ' (you)' : '' %></option><% }) %>
                      </select></td></tr>
                  <% }) %>
                  </tbody>
                </table></div>
                <div class="vq-form-foot"><button class="vq-btn vq-btn--secondary" type="submit" data-vendor-assign-send>Save and email colleagues</button></div>
              </form>
            <% } else { %>
              <ul class="vq-people"><% p.sections.forEach(s => { const cur = assigned.get(s.title); %><li><%= s.title %> <span class="vq-muted"><%= cur ? cur.name + (cur.personId === signedIn.id ? ' (you)' : '') : 'Anyone' %></span></li><% }) %></ul>
            <% } %>
          </section>
        <% } %>

        <% if (docCount) { %>
          <section class="vq-page vq-page--follow vq-card-part" aria-labelledby="ready-title" data-vendor-documents-needed>
            <h2 class="vq-h2" id="ready-title">What to have ready</h2>
            <p class="vq-lead">Add each file once on <a href="<%= base %>?view=documents">Your documents</a>, then choose it on every question it supports.</p>
            <details class="vq-docs">
              <summary class="vq-docs-summary">The documents we ask for (<%= docCount %>)</summary>
              <% p.documentsNeeded.forEach(g => { %>
                <h3 class="vq-docs-group"><%= g.group %></h3>
                <ul class="vq-docs-list">
                  <% g.documents.forEach(d => { %><li data-vendor-document-needed><%= d.name %> <span class="vq-muted">(<%= d.questions.join(', ') %>)</span></li><% }) %>
                </ul>
              <% }) %>
            </details>
          </section>
        <% } %>

        <% if (p.sections.length) { %>
          <section class="vq-page vq-page--follow vq-card-part" id="spreadsheet" aria-labelledby="sheet-title" data-vendor-spreadsheet>
            <h2 class="vq-h2" id="sheet-title">Answer in a spreadsheet <span class="vq-optional">optional</span></h2>
            <p class="vq-lead">Download the questions with your saved answers, fill them in and upload the file. Empty rows keep what is saved. Nothing is submitted. Documents are added on this site, not in the spreadsheet.</p>
            <p><a class="vq-btn vq-btn--secondary" href="<%= base %>/spreadsheet" data-vendor-sheet-download>Download the spreadsheet</a></p>
            <% if (!locals.firmEntry) { %>
            <form method="POST" action="<%= base %>/spreadsheet" enctype="multipart/form-data" class="vq-sheet-form" data-vendor-sheet-upload>
              <input type="hidden" name="_aft" value="<%= aft %>">
              <div class="vq-field"><label class="vq-label" for="sheet-file">Filled-in spreadsheet <span class="vq-optional">.xlsx, up to <%= Math.round(p.sheetLimitBytes / 1048576) %> MB</span></label>
                <input class="vq-file-input" id="sheet-file" type="file" name="sheet" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required></div>
              <div class="vq-form-foot"><button class="vq-btn vq-btn--secondary" type="submit" data-vendor-sheet-send>Upload and save answers</button></div>
            </form>
            <% } %>
          </section>
        <% } %>

        <% const panelKinds = ['iso27001', 'soc2_type2'].filter(k => !p.reports.inQuestions[k] && p.reports.would[k] > 0); %>
        <% if (p.reports.enabled && panelKinds.length) { %>
          <section class="vq-page vq-page--follow vq-card-part" id="reports" aria-labelledby="reports-title" data-vendor-reports>
            <h2 class="vq-h2" id="reports-title">Your certificate or report <span class="vq-optional">optional, saves time</span></h2>
            <p class="vq-lead">A current ISO 27001 certificate or SOC 2 Type II report covers the documents for the questions it applies to.</p>
            <% if (p.reports.counts.total) { %>
              <p class="vq-report-total" data-vendor-report-covers><%= 'Your ' + (p.reports.byKind.iso27001 && p.reports.byKind.soc2_type2 ? 'certificate and report cover' : p.reports.byKind.iso27001 ? 'certificate covers' : 'report covers') %> the evidence for <strong><%= plural(p.reports.counts.total, 'question') %></strong> in this questionnaire.</p>
            <% } %>
            <div class="vq-reports">
              <% panelKinds.forEach(kind => { const r = p.reports.byKind[kind]; const iso = kind === 'iso27001'; const v = rvFor(kind) || {}; %>
                <article class="vq-report<%= r ? ' is-added' : '' %>" data-vendor-report="<%= kind %>">
                  <h3 class="vq-h3"><%= iso ? 'ISO 27001 certificate' : 'SOC 2 Type II report' %><% if (r) { %> <span class="vq-optional">added</span><% } %></h3>
                  <p class="vq-muted"><%= r ? 'Covers the evidence for ' + plural(p.reports.counts[kind], 'question') + '.' : 'Would cover the evidence for up to ' + plural(p.reports.would[kind], 'question') + '.' %></p>
                  <% if (r) { %>
                    <dl class="vq-report-facts">
                      <div><dt><%= iso ? 'Certificate' : 'Report' %></dt><dd class="vq-file-name"><%= r.file ? r.file.name : '' %></dd></div>
                      <% if (iso) { %>
                        <div><dt>Statement of Applicability</dt><dd class="vq-file-name"><%= r.soaFile ? r.soaFile.name : '' %></dd></div>
                        <div><dt>Expires</dt><dd><%= fmtDay(r.certificate_expires_on) %></dd></div>
                        <div><dt>Scope</dt><dd class="vq-pre"><%= r.scope %></dd></div>
                      <% } else { %>
                        <div><dt>Period ended</dt><dd><%= fmtDay(r.period_end) %></dd></div>
                        <div><dt>Bridge letter</dt><dd><%= r.bridgeFile ? '' : 'None' %><% if (r.bridgeFile) { %><span class="vq-file-name"><%= r.bridgeFile.name %></span><% } %></dd></div>
                      <% } %>
                    </dl>
                  <% } %>
                  <% if (r) { %><details class="vq-report-edit"<%= rvFor(kind) ? ' open' : '' %>>
                    <summary class="vq-link-btn">Replace or change</summary><% } %>
                    <% if (!locals.firmEntry) { %>
                    <form method="POST" action="<%= base %>/reports" enctype="multipart/form-data" class="vq-report-form" data-vendor-report-form="<%= kind %>">
                      <input type="hidden" name="_aft" value="<%= aft %>">
                      <input type="hidden" name="kind" value="<%= kind %>">
                      <div class="vq-field">
                        <label class="vq-label" for="rf-<%= kind %>"><%= iso ? 'Certificate' : 'SOC 2 Type II report' %><% if (r) { %> <span class="vq-optional">only to replace it</span><% } %></label>
                        <input class="vq-file-input" id="rf-<%= kind %>" type="file" name="report_file"<%= r ? '' : ' required' %>>
                      </div>
                      <% if (iso) { %>
                        <div class="vq-field">
                          <label class="vq-label" for="rs-<%= kind %>">Statement of Applicability<% if (r) { %> <span class="vq-optional">only to replace it</span><% } %></label>
                          <input class="vq-file-input" id="rs-<%= kind %>" type="file" name="soa_file"<%= r ? '' : ' required' %>>
                        </div>
                        <div class="vq-field vq-field--narrow">
                          <label class="vq-label" for="re-<%= kind %>">Certificate expiry date</label>
                          <input class="vq-input" id="re-<%= kind %>" type="date" name="expires_on" min="<%= today %>" value="<%= v.expires_on || (r ? r.certificate_expires_on : '') %>" required>
                        </div>
                        <div class="vq-field">
                          <label class="vq-label" for="rc-<%= kind %>">Scope <span class="vq-optional">as written on the certificate</span></label>
                          <textarea class="vq-input vq-textarea" id="rc-<%= kind %>" name="scope" rows="3" maxlength="<%= p.limits.scope %>" required><%= v.scope || (r ? r.scope : '') %></textarea>
                        </div>
                      <% } else { %>
                        <div class="vq-field vq-field--narrow">
                          <label class="vq-label" for="rp-<%= kind %>">Report period end date</label>
                          <input class="vq-input" id="rp-<%= kind %>" type="date" name="period_end" max="<%= today %>" value="<%= v.period_end || (r ? r.period_end : '') %>" required>
                        </div>
                        <div class="vq-field">
                          <label class="vq-label" for="rb-<%= kind %>">Bridge letter <span class="vq-optional">optional; useful if the period ended more than 12 months ago</span></label>
                          <input class="vq-file-input" id="rb-<%= kind %>" type="file" name="bridge_file">
                        </div>
                      <% } %>
                      <div class="vq-form-foot"><button class="vq-btn vq-btn--secondary" type="submit" data-vendor-report-save="<%= kind %>"><%= r ? 'Save changes' : (iso ? 'Add certificate' : 'Add report') %></button></div>
                    </form>
                    <% } %>
                  <% if (r) { %></details><% } %>
                  <% if (r) { %>
                    <% if (!locals.firmEntry) { %>
                    <form method="POST" action="<%= base %>/reports" class="vq-report-remove">
                      <input type="hidden" name="_aft" value="<%= aft %>">
                      <input type="hidden" name="kind" value="<%= kind %>">
                      <input type="hidden" name="remove" value="1">
                      <button class="vq-link-btn vq-link-btn--danger" type="submit" data-vendor-report-remove="<%= kind %>">Remove <%= iso ? 'certificate' : 'report' %></button>
                    </form>
                    <% } %>
                  <% } %>
                </article>
              <% }) %>
            </div>
          </section>
        <% } %>
        </div>
      <% } %>

      <% if (view === 'section' && answering && section) { const s = section; const prev = p.sections[s.index - 2] || null; const next = p.sections[s.index] || null;
           const stillNeeded = { evidence: 'a document for this answer.', explain: 'an explanation of your answer.', fields: 'each field of your answer.' };
           const qn = qi => s.questions[qi].id;
           const hereOpen = s.questions.find(isOpenQ) || null;
           const laterSections = p.sections.slice(s.index).concat(p.sections.slice(0, s.index - 1));
           const laterOpen = (() => { for (const x of laterSections) { const q = x.questions.find(isOpenQ); if (q) return q; } return null; })();
           %>
        <section class="vq-section vq-card" data-vendor-section="<%= s.title %>">
        <header class="vq-section-head vq-card-head">
          <div class="vq-head-row">
            <div class="vq-head-text">
              <p class="vq-section-where">Section <%= s.index %> of <%= p.sections.length %> · <span class="vq-section-progress"><%= s.answered %> of <%= s.total %> answered.</span></p>
              <h2 class="vq-section-title" id="<%= s.slug %>"><%= s.title %></h2>
            </div>
            <% if (hereOpen) { %><a class="vq-btn vq-btn--sm vq-next-open" href="#q-<%= hereOpen.id %>" data-vendor-next-unanswered="<%= hereOpen.id %>"<% if (laterOpen) { %> data-vendor-next-later="<%= laterOpen.id %>"<% } %>>Next unanswered</a><% } else if (laterOpen) { %><button class="vq-btn vq-btn--sm vq-next-open" type="submit" form="<%= FORM_ID %>" name="go" value="q:<%= laterOpen.id %>" formnovalidate data-vendor-next-unanswered="<%= laterOpen.id %>">Next unanswered</button><% } %>
          </div>
          <% if (locals.assigned && assigned.get(s.title)) { %><p class="vq-section-assigned">Assigned to <%= assigned.get(s.title).name %></p><% } %>
          <% if (s.summary) { %><p class="vq-section-summary" data-vendor-section-summary><%= s.summary %></p><% } %>
          <% const stillOpen = errorList.length ? 0 : s.questions.filter(q => q.problems.some(x => stillNeeded[x.kind])).length; %>
          <% if (stillOpen || s.aiAdded) { %><p class="vq-section-note"><% if (stillOpen) { %><span data-vendor-section-attention><%= plural(stillOpen, 'question still needs', 'questions still need') %> something before you can submit.</span><% } %><% if (s.aiAdded) { %> Added because you answered Yes to AIS-01.<% } %></p><% } %>
        </header>

        <form method="POST" action="<%= base %>/save" enctype="multipart/form-data" novalidate class="vq-form" id="<%= FORM_ID %>" data-vendor-answer-form<%= errorList.length ? ' data-vendor-unsaved' : '' %>>
          <input type="hidden" name="_aft" value="<%= aft %>">
          <input type="hidden" name="section" value="<%= s.index %>">
          <% s.questions.forEach((q, qi) => { const v = q.value; const errs = errorsFor(q.id); const R = q.rules; const attrJson = o => JSON.stringify(o).replace(/&/g, '&amp;').replace(/"/g, '&#34;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); const valueQ = !!R.valueType; const freeText = R.typed && (R.type === 'free_text' || valueQ); const legacy = !R.typed; const covered = q.badge.key === 'covered';
               const required = !!R.evidenceMandatory && !covered; const needed = !errs.length ? q.problems.filter(x => stillNeeded[x.kind]) : [];
               const docOpen = !!errs.length || needed.some(x => x.kind === 'evidence') || !!(v.picks && v.picks.length);
               const ferr = f => errs.filter(e => e.field === f.key).map(e => e.message);
               const setAside = !!(q.files.length && v.response && !R.evidenceOn.includes(v.response));
               const fileList = () => '<ul class="vq-files" data-vendor-files>' + q.files.map(f => { const also = usedIn(q.id, f.id); const note = [onShelf(f.id) ? 'From your documents' : null, also.length ? 'also used in ' + also.join(', ') : null].filter(Boolean).join(' · ');
                 return '<li class="vq-chip" data-vendor-file="' + f.id + '"><span class="vq-chip-type" aria-hidden="true">' + attr(extOf(f.name)) + '</span><span class="vq-file-name">' + attr(f.name) + '</span> <span class="vq-chip-note">' + attr(sizeOf(f.size)) + (note ? ' · ' + attr(note) : '') + '</span>'
                 + (f.locked ? '' : ' <label class="vq-check vq-check--sm"><input type="checkbox" name="remove[' + q.id + ']" value="' + f.id + '"' + ((v.remove || []).includes(f.id) ? ' checked' : '') + '> Remove when I save</label>') + '</li>'; }).join('') + '</ul>'; %>
            <div class="vq-q<%= errs.length ? ' has-error' : '' %><%= q.followup ? ' vq-followup' : '' %>" id="q-<%= q.id %>" role="group" aria-labelledby="qt-<%= q.id %>" data-vendor-question="<%= q.id %>"<%- q.followup ? ' data-vendor-followup-of="' + q.followup.parent + '"' + (q.followup.rule ? ' data-vendor-followup-rule="' + attrJson(q.followup.rule) + '"' : ' data-vendor-followup-when="' + q.followup.when + '"') + (q.asked ? '' : ' hidden') : '' %> data-kind="<%= legacy ? 'legacy' : freeText ? 'text' : 'choice' %>"<% if (errs.length) { %> aria-invalid="true"<% } %>>
              <input type="hidden" name="v[<%= q.id %>]" value="<%= locals.postedVersions && /^[0-9a-f]{20}$/.test(String(postedVersions[q.id] || '')) && !errs.some(e => e.stale) ? postedVersions[q.id] : q.version %>">
              <span class="vq-q-num" aria-hidden="true"><%= qn(qi) %></span>
              <div class="vq-q-body">
              <% if (q.followup) { %><p class="vq-q-why" data-vendor-followup-why><% if (q.followup.rule) { %>Asked because of your answer<%= q.followup.rule.conditions.length > 1 ? 's' : '' %> to <%= [...new Set(q.followup.rule.conditions.map(c => c.question))].join(' and ') %>.<% } else { %>Asked because you answered <%= p.responseLabels[q.followup.when] || q.followup.when %> to <%= q.followup.parent %>.<% } %></p><% } %>
              <% if (R.required === false) { %><p class="vq-q-why" data-vendor-optional>Optional: you can leave this blank.</p><% } %>
              <p class="vq-q-text" id="qt-<%= q.id %>"><span class="sr-only">Question <%= qn(qi) %>: </span><%= q.question %></p>
              <% if (q.guidance) { %><p class="vq-q-guidance vq-q-guide" id="g-<%= q.id %>"><%- infoIcon %><span><%- guidanceHtml(q.guidance) %></span></p><% } %>
              <% if (q.acronyms && q.acronyms.length) { %>
                <details class="vq-what" data-vendor-what="<%= q.id %>"><summary class="vq-what-summary">What is <%= q.acronyms.map(a => a.term).join(', ') %>?</summary>
                  <dl class="vq-what-list"><% q.acronyms.forEach(a => { %><div><dt><%= a.term %></dt><dd><%= a.meaning %></dd></div><% }) %></dl></details>
              <% } %>
              <% errs.forEach(e => { if (e.stale && e.theirs) { %>
                <div class="vq-clash" role="alert" data-vendor-clash="<%= q.id %>">
                  <p><strong>Not saved.</strong> <%= e.theirs.by %> changed this answer<%= e.theirs.at ? ' at ' + fmtWhen(e.theirs.at) : '' %>, after you opened the page.</p>
                  <p><%= e.theirs.by %>'s answer: <span class="vq-pre"><%= e.theirs.answer %></span></p>
                  <p>Your version is in the form below. Save again if it should replace <%= e.theirs.by %>'s.</p>
                </div>
              <% } else if (!e.field) { %><p class="vq-error" role="alert"><%= e.message %></p><% } }) %>
              <% needed.forEach(x => { %><p class="vq-needed">Still needed: <%= stillNeeded[x.kind] %></p><% }) %>
              <% if (q.fromLastTime) { %>
                <p class="vq-last" data-vendor-from-last-time>Filled in from your answers last time.
                  <label class="vq-check"><input type="checkbox" name="confirm[<%= q.id %>]" value="1"<% if (v.confirm) { %> checked<% } %>> This answer is still correct</label></p>
              <% } %>

              <% if (valueQ && R.valueType === 'file') { %>
                <% if (q.files.length && v.response === 'value') { %><input type="hidden" name="r[<%= q.id %>]" value="value"><% } %>
                <p class="vq-q-guidance" data-vendor-file-question>Upload the file below.</p>
                <% if (R.responses.includes('na')) { %><label class="vq-check vq-na-toggle"><input data-vendor-na class="vq-na-input" type="checkbox" name="r[<%= q.id %>]" value="na"<% if (v.response === 'na') { %> checked<% } %>> This does not apply to us</label><% } %>
              <% } else if (valueQ) { %>
                <div class="vq-fields vq-answer-text" data-vendor-fields="<%= q.id %>" data-vendor-value="<%= R.valueType %>">
                  <% R.fields.forEach(f => { %><%- include('partials/tprm_vendor_field', { q, f, fv: (v.fields || {})[f.key] || '', ferr: ferr(f) }) %><% }) %>
                </div>
                <% if (R.responses.includes('na')) { %><label class="vq-check vq-na-toggle"><input data-vendor-na class="vq-na-input" type="checkbox" name="r[<%= q.id %>]" value="na"<% if (v.response === 'na') { %> checked<% } %>> This does not apply to us</label><% } %>
              <% } else if (freeText && R.fieldsOn === 'answer') { %>
                <div class="vq-fields<%= R.fieldsOn === 'answer' ? ' vq-answer-text' : ' vq-yes' %>" data-vendor-fields="<%= q.id %>">
                  <% R.fields.forEach(f => { %><%- include('partials/tprm_vendor_field', { q, f, fv: (v.fields || {})[f.key] || '', ferr: ferr(f) }) %><% }) %>
                </div>
                <label class="vq-check vq-na-toggle"><input data-vendor-na class="vq-na-input" type="checkbox" name="r[<%= q.id %>]" value="na"<% if (v.response === 'na') { %> checked<% } %>> This does not apply to us</label>
              <% } else if (freeText) { %>
                <div class="vq-field vq-answer-text">
                  <label class="sr-only" for="t-<%= q.id %>">Your answer to question <%= qn(qi) %></label>
                  <textarea class="vq-input vq-textarea" id="t-<%= q.id %>" name="t[<%= q.id %>]" rows="4" maxlength="<%= p.limits.detail %>"<% if (q.guidance) { %> aria-describedby="g-<%= q.id %>"<% } %>><%= v.answer_text || '' %></textarea>
                </div>
                <label class="vq-check vq-na-toggle"><input data-vendor-na class="vq-na-input" type="checkbox" name="r[<%= q.id %>]" value="na"<% if (v.response === 'na') { %> checked<% } %>> This does not apply to us</label>
              <% } else { %>
                <fieldset class="vq-choices">
                  <legend class="sr-only">Your answer to question <%= qn(qi) %></legend>
                  <% R.responses.forEach(r => { %>
                    <label class="vq-choice"><input class="vq-choice-input" type="radio" id="r-<%= q.id %>-<%= r %>" name="r[<%= q.id %>]" value="<%= r %>"<% if (v.response === r) { %> checked<% } %><% if (!legacy && R.explainOn.includes(r)) { %> data-explain<% } %><% if (!legacy && R.evidenceOn.includes(r)) { %> data-evidence<% } %><% if (r === 'yes' && (R.fieldsOn === 'yes' || R.detailsOnYes)) { %> data-yes<% } %><% if (q.guidance) { %> aria-describedby="g-<%= q.id %>"<% } %>> <%= p.responseLabels[r] %></label>
                  <% }) %>
                </fieldset>
                <% if (R.fieldsOn === 'yes') { %>
                <div class="vq-fields<%= R.fieldsOn === 'answer' ? ' vq-answer-text' : ' vq-yes' %>" data-vendor-fields="<%= q.id %>">
                  <% R.fields.forEach(f => { %><%- include('partials/tprm_vendor_field', { q, f, fv: (v.fields || {})[f.key] || '', ferr: ferr(f) }) %><% }) %>
                </div>
                <% } else if (R.detailsOnYes) { %>
                <div class="vq-field vq-yes" data-vendor-yes-details="<%= q.id %>">
                  <label class="vq-label" for="y-<%= q.id %>"><%= R.detailsOnYes %></label>
                  <textarea class="vq-input vq-textarea" id="y-<%= q.id %>" name="y[<%= q.id %>]" rows="3" maxlength="<%= p.limits.detail %>"><%= v.yes_details || '' %></textarea>
                </div>
                <% } %>
              <% } %>

              <div class="vq-field vq-explain">
                <label class="vq-label" for="d-<%= q.id %>"><%= legacy ? 'Details' : 'Explanation' %> <span class="vq-optional"><%= legacy ? 'needed for Partially, No and Not applicable' : freeText ? 'why this does not apply' : 'needed for ' + R.explainOn.map(x => p.responseLabels[x]).join(' and ') %></span></label>
                <textarea class="vq-input vq-textarea" id="d-<%= q.id %>" name="d[<%= q.id %>]" rows="3" maxlength="<%= p.limits.detail %>"><%= v.detail %></textarea>
              </div>

              <% if (q.evidence || required || q.files.length || v.evidence_ref || legacy) { %>
              <div class="vq-evidence">
                <% if (covered) { %>
                  <p class="vq-doc-line"><span data-vendor-evidence-covered><%= q.badge.label %></span>, so no document is needed here.</p>
                <% } else if (q.evidence) { %>
                  <p class="vq-doc-line"<% if (required) { %> data-vendor-evidence-required<% } %>><%= required ? 'Document for this answer' : 'Document, if you have one' %>: <%= q.evidence %><%= /[.!?]$/.test(q.evidence) ? '' : '.' %></p>
                <% } else if (required) { %>
                  <p class="vq-doc-line" data-vendor-evidence-required>This answer needs a supporting document.</p>
                <% } %>
                <% if (q.files.length && !setAside) { %><%- fileList() %><% } %>
                <% const savedRef = q.answer && q.answer.evidence_ref; if (savedRef && !q.files.length) { %><p class="vq-doc-named" data-vendor-named>Named: <%= savedRef %><%= q.answer.evidence_date ? ', dated ' + fmtDay(q.answer.evidence_date) : '' %></p><% } %>
                <details class="vq-doc"<%= docOpen ? ' open' : '' %>>
                  <summary class="vq-doc-summary"><%= q.files.length || savedRef ? 'Add another document or change it' : 'Add a document' %></summary>
                  <% const choosable = shelfFor(q); if (choosable.length) { %>
                    <fieldset class="vq-pick" data-vendor-pick="<%= q.id %>">
                      <legend class="vq-label">Choose from your documents</legend>
                      <% choosable.forEach(d => { %><label class="vq-check"><input type="checkbox" name="pick[<%= q.id %>]" value="<%= d.id %>"<%= (v.picks || []).includes(d.id) ? ' checked' : '' %>> <span><span class="vq-file-name"><%= d.name %></span><% if (d.description) { %> <span class="vq-muted"><%= d.description %></span><% } %></span></label><% }) %>
                    </fieldset>
                  <% } %>
                  <p class="vq-pick-more"><button type="submit" form="<%= FORM_ID %>" name="go" value="documents" formnovalidate class="vq-link-btn" data-vendor-to-documents>Add files to your documents</button> <span class="vq-muted">saves this section first</span></p>
                  <div class="vq-field vq-attach">
                    <label class="vq-label" for="f-<%= q.id %>">Attach a file <span class="vq-optional">up to <%= fileMb %> MB</span></label>
                    <input class="vq-file-input" id="f-<%= q.id %>" type="file" name="file__<%= q.id %>">
                  </div>
                  <div class="vq-row">
                    <div class="vq-field"><label class="vq-label" for="ref-<%= q.id %>">Or name the document <span class="vq-optional">title, version or link</span></label>
                      <input class="vq-input" id="ref-<%= q.id %>" name="ref[<%= q.id %>]" maxlength="<%= p.limits.evidenceRef %>" value="<%= v.evidence_ref %>"></div>
                    <div class="vq-field"><label class="vq-label" for="date-<%= q.id %>">Document date</label>
                      <input class="vq-input" id="date-<%= q.id %>" type="date" name="date[<%= q.id %>]" max="<%= today %>" value="<%= v.evidence_date %>"></div>
                  </div>
                </details>
              </div>
              <% } %>
              <% if (setAside) { %>
              <div class="vq-set-aside" data-vendor-set-aside="<%= q.id %>">
                <p class="vq-doc-line">Kept from an earlier answer. With the answer "<%= p.responseLabels[v.response] || v.response %>", no document is needed, so the reviewers do not see <%= q.files.length === 1 ? 'this file' : 'these files' %>. Remove <%= q.files.length === 1 ? 'it' : 'them' %>, or change the answer back.</p>
                <%- fileList() %>
              </div>
              <% } %>
              <% if (q.report) { const rq = q.report; const noun = rq.kind === 'iso27001' ? 'certificate' : 'report'; const others = plural(rq.would, 'other question'); %>
                <p class="vq-report-note" data-vendor-report-note="<%= rq.kind %>"><%=
                  rq.row ? 'Saved as your ' + rq.label + '. It covers the documents for ' + others + (rq.row.file && !q.files.some(f => f.id === rq.row.file.id) ? ' (file: ' + rq.row.file.name + ')' : '') + '.'
                  : rq.draft.expired ? 'This certificate has expired, so it cannot cover other questions.'
                  : rq.draft.answered && rq.draft.problems.length ? 'To use this ' + noun + ' for ' + others + ', ' + rq.draft.problems.join(', ') + '.'
                  : rq.kind === 'iso27001' ? 'Answer Yes with the certificate and the Statement of Applicability attached, as a second file here' + (rq.extraAsked ? ' or on ' + 'ASR-02' : '') + ', and together they cover the documents for ' + others + '. Naming the Statement of Applicability is not enough: the file is needed.'
                  : 'Answer Yes with the report attached and its period end date, and it covers the documents for ' + others + '.' %></p>
              <% } %>
              <% if (q.comments.length) { %>
                <ul class="vq-comments" data-vendor-comments="<%= q.id %>">
                  <% q.comments.forEach(c => { %><li><span class="vq-comment-by"><%= c.name %>, <%= fmtWhen(c.at) %></span><span class="vq-pre"><%= c.body %></span></li><% }) %>
                </ul>
              <% } %>
              <% const cv = locals.postedComments && typeof postedComments[q.id] === 'string' ? postedComments[q.id] : ''; %>
              <% if (!locals.firmEntry) { %><details class="vq-comment-add"<%= cv ? ' open' : '' %>>
                <summary class="vq-doc-summary vq-lk"><%- commentIcon %>Add a comment</summary>
                <div class="vq-field"><label class="vq-label" for="c-<%= q.id %>">Comment for the reviewers <span class="vq-optional">saved with this section</span></label>
                  <textarea class="vq-input vq-textarea" id="c-<%= q.id %>" name="c[<%= q.id %>]" rows="2" maxlength="<%= p.limits.comment %>" aria-describedby="cw-<%= q.id %>"><%= cv %></textarea>
                  <p class="vq-muted" id="cw-<%= q.id %>" data-vendor-comment-who><%= commentWho %></p></div>
              </details><% } %>
              <% if (q.answer && q.answer.saved_at && q.answer.response) { const savedOnly = q.problems.length > 0; %><p class="vq-q-by" <%= savedOnly ? 'data-vendor-saved-by' : 'data-vendor-answered-by' %>><%= savedOnly ? 'Saved' : 'Answered' %><%= q.answer.saved_by_name ? ' by ' + q.answer.saved_by_name : '' %><%= q.answer.saved_by_firm ? ' of ' + firmName + ', on your behalf,' : '' %> on <%= fmtWhen(q.answer.saved_at) %><%= savedOnly ? '. Not complete yet: it still needs something before you can submit.' : '' %></p><% } %>
              </div>
            </div>
          <% }) %>

          <span class="vq-jump vq-jump--kept" data-vendor-jump>
            <label class="sr-only" for="vq-jump">Go to a section</label>
            <select class="vq-input vq-jump-select" id="vq-jump" name="jump">
              <option value="start">Overview</option>
              <% p.sections.forEach(x => { %><option value="<%= goValue(x) || 'review' %>"<%= x.index === s.index ? ' selected' : '' %>>Section <%= x.index %> of <%= p.sections.length %>: <%= x.title %></option><% }) %>
              <option value="review">Review and submit</option>
            </select>
            <button class="vq-btn vq-btn--secondary vq-jump-go" type="submit" name="go" value="jump" formnovalidate data-vendor-jump-go>Save and go</button>
          </span>
        </form>

        </section>
      <% } %>

      <% if (view === 'documents' && answering) { %>
        <section class="vq-page vq-card" aria-labelledby="documents-title" data-vendor-documents>
          <h2 class="vq-page-title" id="documents-title">Your documents</h2>
          <p class="vq-lead">Add each file once, then choose it on each question it supports. The reviewers see the files you choose for your answers.</p>
          <% if (p.shelf.length) { %>
            <ul class="vq-shelf" data-vendor-shelf>
              <% p.shelf.forEach(d => { %>
                <li class="vq-shelf-item" data-vendor-shelf-item="<%= d.id %>">
                  <p class="vq-shelf-name"><span class="vq-file-name"><%= d.name %></span> <span class="vq-muted"><%= sizeOf(d.size) %>, added <%= fmtDay(d.uploadedAt) %></span></p>
                  <p class="vq-shelf-use vq-muted"><%= d.report ? 'Used for your certificate or report. ' : '' %><%= d.answers ? 'Chosen for ' + plural(d.answers, 'answer') + '.' : (d.report ? '' : 'Not chosen for any answer yet.') %><%= d.locked ? ' The reviewers are using it.' : '' %></p>
                  <% if (!locals.firmEntry) { %>
                  <form method="POST" action="<%= base %>/documents/<%= d.id %>" class="vq-shelf-form">
                    <input type="hidden" name="_aft" value="<%= aft %>">
                    <label class="sr-only" for="desc-<%= d.id %>">Description of <%= d.name %></label>
                    <input class="vq-input" id="desc-<%= d.id %>" name="description" maxlength="<%= p.limits.description %>" value="<%= d.description %>" placeholder="What it shows, for example the policy and its version">
                    <button class="vq-btn vq-btn--secondary" type="submit" data-vendor-describe="<%= d.id %>">Save description</button>
                  </form>
                  <% } %>
                  <% if (d.deletable) { %>
                    <% if (!locals.firmEntry) { %>
                    <form method="POST" action="<%= base %>/documents/<%= d.id %>" class="vq-shelf-delete">
                      <input type="hidden" name="_aft" value="<%= aft %>">
                      <input type="hidden" name="delete" value="1">
                      <button class="vq-link-btn vq-link-btn--danger" type="submit" data-vendor-delete-document="<%= d.id %>">Delete this document</button>
                    </form>
                    <% } %>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="vq-muted" data-vendor-shelf-empty>No documents yet.</p>
          <% } %>
          <% if (!locals.firmEntry) { %>
          <form method="POST" action="<%= base %>/documents" enctype="multipart/form-data" class="vq-shelf-add" data-vendor-add-documents>
            <input type="hidden" name="_aft" value="<%= aft %>">
            <h3 class="vq-h3">Add documents <span class="vq-optional">up to 3 at a time, <%= fileMb %> MB each</span></h3>
            <% [1, 2, 3].forEach(n => { %>
              <div class="vq-row vq-shelf-row">
                <div class="vq-field"><label class="vq-label" for="doc-file-<%= n %>">File <%= n %></label>
                  <input class="vq-file-input" id="doc-file-<%= n %>" type="file" name="doc_file_<%= n %>"></div>
                <div class="vq-field"><label class="vq-label" for="doc-desc-<%= n %>">What it shows <span class="vq-optional">optional</span></label>
                  <input class="vq-input" id="doc-desc-<%= n %>" name="desc_<%= n %>" maxlength="<%= p.limits.description %>"></div>
              </div>
            <% }) %>
            <div class="vq-form-foot"><button class="vq-btn vq-btn--primary" type="submit" data-vendor-documents-save>Add these documents</button></div>
          </form>
          <% } %>
          <p class="vq-back"><a href="<%= started && firstOpen ? sectionHref(firstOpen.index) : sectionHref(1) %>">Back to the questions</a></p>
        </section>
      <% } %>

      <% if (view === 'confirm' && answering) { const ready = !p.problems.length; %>
        <section class="vq-page vq-card" aria-labelledby="confirm-title" data-vendor-confirm>
          <h2 class="vq-page-title" id="confirm-title">Review and submit</h2>
          <% if (!ready) { %>
            <p class="vq-lead" data-vendor-problem-count><%= plural(p.problems.length, 'item needs', 'items need') %> attention before you can submit. Your answers so far are saved.</p>
          <% } else { %>
            <p class="vq-lead" data-vendor-ready>All <%= p.total %> questions are answered. Once you submit, your answers can no longer be changed.</p>
          <% } %>
          <div class="vq-panel">
          <table class="vq-table">
            <thead><tr><th scope="col">Section</th><th scope="col" class="vq-num">Answered</th><th scope="col">Still to do</th></tr></thead>
            <tbody>
              <% p.sections.forEach(s => { const left = s.total - s.responded; %>
                <tr data-vendor-review-section="<%= s.title %>">
                  <td><a href="<%= sectionHref(s.index) %>"><%= s.title %></a></td>
                  <td class="vq-num"><%= s.answered %> of <%= s.total %></td>
                  <td><%= s.complete ? 'Done' : [left ? left + ' unanswered' : null, s.attention ? plural(s.attention, 'needs', 'need') + ' attention' : null].filter(Boolean).join(', ') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          </div>
          <% if (!ready) { %>
            <h3 class="vq-h3">What is missing</h3>
            <% const kindWord = { unanswered: 'not answered', evidence: 'need a document', explain: 'need an explanation', fields: 'need details', confirm: 'to confirm' };
               const groups = p.sections.map(s => ({ s, items: p.problems.filter(x => x.section === s.index) })).filter(g => g.items.length); %>
            <div class="vq-missing-groups" data-vendor-problems>
              <% groups.forEach((g, gi) => { const counts = {}; g.items.forEach(x => { counts[x.kind] = (counts[x.kind] || 0) + 1; }); const urgent = g.items.some(x => x.kind !== 'unanswered'); %>
                <details class="vq-missing-group"<%= urgent || gi < 2 ? ' open' : '' %>>
                  <summary><span class="vq-missing-title"><%= g.s.title %></span> <span class="vq-missing-count"><%= Object.entries(counts).map(([k, n]) => n + ' ' + (n === 1 ? kindWord[k].replace(/^need /, 'needs ') : kindWord[k])).join(', ') %></span></summary>
                  <ul class="vq-missing">
                    <% g.items.forEach(x => { %><li data-vendor-problem="<%= x.id %>" data-vendor-problem-kind="<%= x.kind %>"><a href="<%= sectionHref(x.section, 'q-' + x.id) %>"><%= questionText(x.id) %></a> <span class="vq-muted"><%= x.id %>.</span> <span class="vq-missing-why"><%= x.message %></span></li><% }) %>
                  </ul>
                </details>
              <% }) %>
            </div>
            <div class="vq-cta"><a class="vq-btn vq-btn--primary" href="<%= sectionHref(p.problems[0].section, 'q-' + p.problems[0].id) %>" data-vendor-back>Go to the first one</a></div>
          <% } else if (locals.canSubmit === false) { %>
            <p class="vq-lead" data-vendor-submit-main-only>Everything is answered. Only the main contact<%= locals.mainContact ? ', ' + mainContact.name + ',' : '' %> can submit the questionnaire: tell them it is ready.</p>
          <% } else { %>
            <form method="POST" action="<%= base %>/submit" class="vq-submit" data-vendor-submit-form>
              <input type="hidden" name="_aft" value="<%= aft %>">
              <label class="vq-check vq-check--confirm"><input type="checkbox" name="confirm_submit" value="1" required data-vendor-submit-confirm> I confirm these answers are accurate and complete to the best of my knowledge, and that they can be shared with <%= ctx.clientName %>.</label>
              <div class="vq-form-foot">
                <a class="vq-btn vq-btn--quiet" href="<%= sectionHref(1) %>">Go back to the questions</a>
                <button class="vq-btn vq-btn--primary vq-btn--lg" type="submit" data-vendor-submit>Submit answers to <%= ctx.clientName %></button>
              </div>
            </form>
          <% } %>
        </section>
      <% } %>
    </main>

    <% if (showRail) { const team = locals.signedIn && locals.colleagues && !locals.firmEntry ? colleagues : null; const isMain = !!(locals.signedIn && signedIn.role === 'main'); const labels = locals.roleLabels || {}; %>
    <aside class="vq-rail" aria-label="About this review">
      <section class="vq-rcard vq-rcard--dark" aria-labelledby="rail-about">
        <h2 class="vq-rtitle" id="rail-about">About this review</h2>
        <ul class="vq-kv">
          <li><span class="vq-kv-k">For</span><span class="vq-kv-v"><%= ctx.clientName %></span></li>
          <% if (brandName) { %><li><span class="vq-kv-k">Run by</span><span class="vq-kv-v"><%= brandName %></span></li><% } %>
          <% if (reviewerName) { %><li><span class="vq-kv-k">Reviewer</span><span class="vq-kv-v"><%= reviewerName %></span></li><% } %>
          <% if (ctx.expiresAt) { %><li><span class="vq-kv-k">Due</span><span class="vq-kv-v"><%= fmtDay(ctx.expiresAt) %></span></li><% } %>
        </ul>
      </section>
      <% if (team && team.length) { %>
      <section class="vq-rcard" aria-labelledby="rail-team" data-vendor-rail-team>
        <h2 class="vq-rtitle" id="rail-team">Your team on this review</h2>
        <ul class="vq-team">
          <% team.forEach(c => { const me = Number(c.id) === Number(signedIn.id); %><li><span><%= c.name || c.email %></span><span class="vq-team-role"><%= me ? 'You' : (c.job_title || labels[c.role] || '') %></span></li><% }) %>
        </ul>
        <% const peopleLabel = isMain ? 'Invite a colleague' : 'See your colleagues'; %>
        <% if (onSection) { %><button class="vq-btn vq-btn--sm vq-rail-btn" type="submit" form="<%= FORM_ID %>" name="go" value="people" formnovalidate data-vendor-invite><%= peopleLabel %></button><% } else { %><a class="vq-btn vq-btn--sm vq-rail-btn" href="/vendor/p/people" data-vendor-invite><%= peopleLabel %></a><% } %>
      </section>
      <% } %>
      <% if (answering) { %>
      <section class="vq-rcard" aria-labelledby="rail-time" data-vendor-rail-time>
        <h2 class="vq-rtitle" id="rail-time">Save time</h2>
        <% const railCovered = p.coveredDocuments && view !== 'start'; if (railCovered) { %><p class="vq-rail-text" data-vendor-rail-covered>Your certificate or report covers the documents for <strong><%= plural(p.coveredDocuments, 'question') %></strong>, so they need none of their own.</p><% } %>
        <p class="vq-rail-text<%= railCovered ? ' vq-rail-split' : '' %>" data-vendor-rail-sheet>Prefer a spreadsheet? <a href="<%= base %>/spreadsheet">Download with your answers</a><% if (locals.firmEntry) { %>.<% } else { %>, fill it in, then upload it <% if (view === 'start') { %><a href="#spreadsheet">below</a><% } else { %>on the <a href="<%= base %>#spreadsheet">Overview</a><% } %>.<% } %></p>
      </section>
      <% } %>
    </aside>
    <% } %>
  </div>

  <% if (onSection) { const s = section; const prev = p.sections[s.index - 2] || null; const next = p.sections[s.index] || null; %>
  <div class="vq-footbar" data-vendor-actions>
    <div class="vq-footbar-in">
      <% if (prev) { %><button class="vq-btn vq-btn--prev" form="<%= FORM_ID %>" type="submit" name="go" value="<%= goValue(prev) %>" formnovalidate data-vendor-prev>Previous section</button><% } else { %><button class="vq-btn vq-btn--prev" form="<%= FORM_ID %>" type="submit" name="go" value="start" formnovalidate data-vendor-prev>Overview</button><% } %>
      <p class="vq-footbar-note">Your answers are saved each time you change section. You can leave and come back.</p>
      <span class="vq-actions-gap"></span>
      <button class="vq-btn" form="<%= FORM_ID %>" type="submit" name="go" value="<%= locals.firmEntry ? 'start' : 'home' %>" formnovalidate data-vendor-save>Save and exit</button>
      <button class="vq-btn vq-btn--next" form="<%= FORM_ID %>" type="submit" name="intent" value="next" data-vendor-next><%= next ? 'Next section' : 'Save and review' %></button>
    </div>
  </div>
  <% } %>

  <div class="vq-pagefoot">
    <% if (answering) { %><p class="vq-phone-excel"><a href="<%= base %>/spreadsheet">Download as Excel</a></p><% } %>
    <%- include('partials/tprm_vendor_footer', { firm: p.firm, expiresAt: null, note: locals.signedIn ? '' : 'Do not share this link.', runBy: brandName ? { firm: brandName, client: ctx.clientName, logo: frame && frame.firm ? frame.firm.logo : null, logoOnDark: !!(frame && frame.firm && frame.firm.logoOnDark) } : null }) %>
  </div>
</body>
</html>
