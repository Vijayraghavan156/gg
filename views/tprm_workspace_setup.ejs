<%- include('partials/header', { title: ws.client_name, user, ws, active: 'setup' }) %>

<div class="page-head" data-tprm-workspace-setup="<%= ws.id %>">
  <div>
    <h1 class="page-title"><%= ws.brand_display_name || ws.client_name %></h1>
    <div class="page-subtitle">Client setup · Third-party risk<% if (ws.industry) { %> · <%= ws.industry %><% } %></div>
  </div>
  <a class="btn btn-primary" href="/tprm/clients/<%= ws.id %>" data-tprm-workspace-register>Open the third-party register</a>
</div>

<section class="panel panel-pad" style="margin-bottom:18px;">
  <h2 style="margin:0 0 8px;font-size:16px;font-weight:500;">Services</h2>
  <p style="margin:0 0 6px;line-height:1.55;"><strong style="font-weight:500;">Third-party risk</strong> is switched on. The firm assesses the client's third parties and recommends; the client decides.</p>
  <p class="meta" style="margin:0;line-height:1.55;">No ISO programme is part of this engagement, so ISO scoping, readiness and reports do not apply.</p>
</section>

<section class="panel panel-pad" style="margin-bottom:18px;" data-tprm-workspace-scope>
  <h2 style="margin:0 0 8px;font-size:16px;font-weight:500;">Scope recorded when the client was created</h2>
  <% if (ws.scope && String(ws.scope).trim()) { %>
    <p style="margin:0;white-space:pre-wrap;line-height:1.6;"><%= ws.scope %></p>
  <% } else { %>
    <p class="meta" style="margin:0;">No scope was written when the client was created.</p>
  <% } %>
</section>

<section class="panel panel-pad" style="margin-bottom:18px;">
  <h2 style="margin:0 0 8px;font-size:16px;font-weight:500;">Next steps</h2>
  <ol style="margin:0;padding-left:20px;line-height:1.9;">
    <li><a href="/tprm/clients/<%= ws.id %>">Add or import the client's third parties</a>, then start their assessments.</li>
    <% if (canSettings) { %><li><a href="/tprm/clients/<%= ws.id %>/settings">Choose the client's rulebooks and labels</a> in third-party risk settings.</li><% } %>
    <li><a href="/workspaces/<%= ws.id %>/team">Invite the client's people</a> so they can follow their third parties and decide.</li>
  </ol>
</section>

<% if (canUpdateWorkspace) { %>
<details class="panel panel-pad" style="margin-bottom:18px;">
  <summary style="cursor:pointer;font-weight:500;">Add an ISO 27001 programme</summary>
  <form id="programme-enable-form" method="POST" action="/workspaces/<%= ws.id %>/frameworks" style="margin-top:14px;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;"><input id="enable-iso27001-programme" type="checkbox" name="frameworks" value="iso27001" style="margin-top:3px;"><span><strong style="display:block;font-weight:500;">ISO 27001:2022</strong><span class="meta">Information security management and certification readiness</span></span></label>
    <fieldset style="border:1px solid var(--border);border-radius:8px;padding:14px;margin:14px 0 0;">
      <legend class="label" style="padding:0 5px;">Contracted ISO management-system outcome <span class="meta">required with ISO 27001</span></legend>
      <% outcomeOptions.forEach(option => { %>
        <label style="display:flex;align-items:flex-start;gap:9px;cursor:pointer;margin-bottom:8px;">
          <input type="radio" name="engagement_outcome" value="<%= option.value %>" style="margin-top:3px;">
          <span><strong style="display:block;font-weight:500;"><%= option.label %></strong><span class="meta" style="display:block;line-height:1.45;"><%= option.description %></span></span>
        </label>
      <% }) %>
      <label class="label" for="enable-target-cert-date" style="margin-top:6px;">Target certification date <span class="meta">optional, full support only</span></label>
      <input class="input" id="enable-target-cert-date" type="date" name="target_cert_date" style="max-width:240px;">
    </fieldset>
    <div style="margin-top:14px;"><button class="btn btn-secondary">Add ISO 27001</button></div>
  </form>
</details>
<% } %>

<%- include('partials/footer') %>
