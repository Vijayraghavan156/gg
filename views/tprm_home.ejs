<%- include('partials/header', { title: 'Third-party risk', user, active }) %>
<%
  const pl = typeof pipelineView !== 'undefined' && pipelineView ? pipelineView : { rows: [], all: 0, counts: { waitingForMe: 0, late: 0, dueSoon: 0, mine: 0, total: 0 }, filters: { who: 'all', waiting: '', late: false, due30: false, sort: 'due', dir: 'asc', q: '' } };
  const f = pl.filters;
  const plural = (n, one, many) => n + ' ' + (n === 1 ? one : (many || one + 's'));
  const qs = over => { const p = Object.assign({ who: f.who !== 'all' ? f.who : '', waiting: f.waiting, late: f.late ? '1' : '', due: f.due30 ? '30' : '', q: f.q, sort: f.sort !== 'due' ? f.sort : '', dir: f.dir !== 'asc' ? f.dir : '' }, over || {}); const s = Object.entries(p).filter(([, v]) => v).map(([k, v]) => k + '=' + encodeURIComponent(v)).join('&'); return '/tprm' + (s ? '?' + s : ''); };
  const sortHref = k => qs({ sort: k === 'due' ? '' : k, dir: f.sort === k && f.dir === 'asc' ? 'desc' : '' });
  const ariaSort = k => f.sort === k ? (f.dir === 'asc' ? 'ascending' : 'descending') : 'none';
  const tierLabels = { low: 'Low', medium: 'Medium', high: 'High', critical: 'Critical' };
  const day = d => (d ? tpf.day(d) : '');
  const filtered = f.who !== 'all' || f.waiting || f.late || f.due30 || f.q;
%>
<div class="tprm-home" data-tprm-area>
<div class="tprm-head tprm-head--line">
  <div class="tprm-head-main">
    <h1 class="page-title">Third-party risk</h1>
    <p class="tprm-status-line" data-tprm-pipeline-summary><% if (!pl.all) { %>No assessment is open.<% } else { %><%= plural(pl.all, 'assessment') %> open<%= pl.clientCount > 1 ? ' across ' + plural(pl.clientCount, 'client') : '' %>.<% if (pl.counts.late) { %> <%= pl.counts.late %> <%= pl.counts.late === 1 ? 'is' : 'are' %> late.<% } %><% if (pl.counts.waitingForMe) { %> <%= pl.counts.waitingForMe %> <%= pl.counts.waitingForMe === 1 ? 'is' : 'are' %> waiting for you.<% } %><% } %></p>
  </div>
  <% if (typeof canViewCriticality !== 'undefined' && canViewCriticality) { %><div class="tprm-head-actions"><a class="btn btn-secondary" href="/tprm/settings" data-tprm-settings-button>Settings</a></div><% } %>
</div>

<%- include('partials/tprm_home_tabs', { current: 'pipeline', reviewCount: typeof reviewCount === 'number' ? reviewCount : null }) %>
<% const hb = typeof hub !== 'undefined' && hub ? hub : null;
   const fxDonut = (parts, total, label) => { const r = 34, C = 2 * Math.PI * r; let a = 0; let out = '<svg class="fx-donut" viewBox="0 0 92 92" aria-hidden="true"><circle cx="46" cy="46" r="' + r + '" class="tr"/>';
     if (total > 0) parts.forEach(pp => { if (!pp.count) return; const l = C * pp.count / total; out += '<circle cx="46" cy="46" r="' + r + '" class="sg fx-c-' + pp.cls + '" stroke-dasharray="' + l.toFixed(2) + ' ' + (C - l).toFixed(2) + '" stroke-dashoffset="' + (-a).toFixed(2) + '" transform="rotate(-90 46 46)"/>'; a += l; });
     return out + '<text x="46" y="51" text-anchor="middle">' + label + '</text></svg>'; };
   const stageCls = { scope: 'grey', third_party: 'amber', consultant: 'teal', reviewer: 'blue', client: 'green' };
   const fxTier = t => t ? '<span class="fx-tag fx-t-' + t + '">' + (tierLabels[t] || t) + '</span>' : '<span class="fx-muted">-</span>'; %>
<% if (hb) { %>
<div class="fx-hub" data-tprm-hub>
  <section class="fx-card fx-tile" data-tprm-hub-tile="stages"><h3 class="fx-h4">Open reviews <span>by stage</span></h3>
    <div class="fx-donut-row"><%- fxDonut(hb.stages.map(s => ({ count: s.count, cls: stageCls[s.key] })), hb.total, String(hb.total)) %>
      <ul class="fx-legend"><% hb.stages.forEach(s => { %><li><i class="fx-c-<%= stageCls[s.key] %>"></i><%= s.label %><b><%= s.count %></b></li><% }) %></ul></div>
    <div class="fx-foot"><div>Days since the last change, with the supplier<b><%= hb.supplierDays == null ? '-' : hb.supplierDays %></b></div><div>Days since the last change, with your team<b><%= hb.teamDays == null ? '-' : hb.teamDays %></b></div></div></section>
  <section class="fx-card fx-tile" data-tprm-hub-tile="you"><h3 class="fx-h4">Waiting on you <span><%= user.name %></span></h3>
    <div class="fx-big<%= hb.waitingOnYou ? ' fx-warn' : '' %>"><%= hb.waitingOnYou %></div><div class="fx-muted fx-sm">item<%= hb.waitingOnYou === 1 ? '' : 's' %> in My work below</div>
    <div class="fx-foot"><% hb.waitingBreakdown.forEach(([l, n]) => { %><div><%= l %><b><%= n %></b></div><% }) %></div></section>
  <section class="fx-card fx-tile" data-tprm-hub-tile="late"><h3 class="fx-h4">Late and due soon</h3>
    <div class="fx-big<%= hb.late ? ' fx-bad' : '' %>"><%= hb.late %></div><div class="fx-muted fx-sm">review<%= hb.late === 1 ? '' : 's' %> past the due date</div>
    <div class="fx-foot"><div>Due in the next 30 days<b><%= hb.dueSoon %></b></div><div>Conditions overdue<b<%- hb.conditionsOverdue ? ' class="fx-bad"' : '' %>><%= hb.conditionsOverdue %></b></div><div>Questionnaire links ending this week<b><%= hb.linksExpiring %></b></div></div></section>
  <div class="fx-stack">
    <section class="fx-card" data-tprm-hub-tile="clients"><h3 class="fx-h4">Open reviews by client</h3>
      <% if (!hb.byClient.length) { %><p class="fx-muted fx-sm">No review is open.</p><% } %>
      <% hb.byClient.forEach(c => { %><div class="fx-hbar"><a href="/tprm/clients/<%= c.id %>"><%= c.name %></a><span class="bar"><b style="width:<%= Math.round(c.open / hb.maxOpen * 100) %>%"></b></span><em><%= c.open %></em></div><% }) %></section>
    <section class="fx-card" data-tprm-hub-tile="decisions"><h3 class="fx-h4">Client decisions this quarter <span>all clients</span></h3>
      <div class="fx-mini3"><div><b class="fx-ok"><%= hb.decisions.approved %></b><span>Approved</span></div><div><b class="fx-warn"><%= hb.decisions.conditions %></b><span>With conditions</span></div><div><b class="fx-bad"><%= hb.decisions.rejected %></b><span>Not approved</span></div></div></section>
  </div>
</div>

<h2 class="fx-section-h" id="my-work">My work <span><%= hb.work.length %> item<%= hb.work.length === 1 ? '' : 's' %>, late first</span></h2>
<div class="fx-table" data-tprm-my-work>
  <% if (!hb.work.length) { %><div class="fx-empty" data-tprm-my-work-empty>Nothing is waiting on you.</div><% } else { %>
  <div class="table-scroll"><table><thead><tr><th>What to do</th><th>Third party</th><th>Client</th><th>Tier</th><th>Waiting</th><th>Due</th><th></th></tr></thead><tbody>
  <% hb.work.forEach(w => { %><tr<%- w.late ? ' class="is-late"' : '' %> data-tprm-work-item="<%= w.kind %>">
    <td><b><%= w.what %></b><% if (w.detail) { %><span class="fx-sub"><%= w.detail %></span><% } %></td>
    <td><%= w.thirdParty %><span class="fx-sub"><%= w.sub %></span></td><td><%= w.client %></td><td><%- fxTier(w.tier) %></td>
    <td><%= w.since === 0 ? 'today' : w.since + ' day' + (w.since === 1 ? '' : 's') %></td>
    <td><% if (w.due) { %><span class="<%= w.late ? 'fx-bad' : '' %>"><%= day(w.due) %></span><% } else { %><span class="fx-muted">-</span><% } %></td>
    <td class="tprm-right"><a class="btn btn-secondary btn-xs" href="<%= w.href %>">Open</a></td></tr><% }) %>
  </tbody></table></div><% } %>
</div>
<h2 class="fx-section-h">All open reviews <span>every client you can reach</span></h2>
<% } %>

<section class="tpa tprm-pipeline" aria-labelledby="pipeline-title" data-tprm-pipeline>
  <h2 class="sr-only" id="pipeline-title">Open assessments</h2>
  <p class="tprm-pipeline-counts" data-tprm-pipeline-counts>
    <a href="<%= qs({ who: 'me', waiting: '', late: '', due: '' }) %>" data-tprm-count="me"><%= plural(pl.counts.waitingForMe, 'assessment') %> waiting for you</a>
    · <a href="<%= qs({ late: '1', who: '', waiting: '', due: '' }) %>" data-tprm-count="late"><%= pl.counts.late %> late</a>
    · <a href="<%= qs({ due: '30', who: '', waiting: '', late: '' }) %>" data-tprm-count="due"><%= pl.counts.dueSoon %> due in the next 30 days</a>
    <% if (filtered) { %>· <a href="/tprm" data-tp-list-clear>Show all <%= pl.all %></a><% } %>
  </p>
  <form method="GET" action="/tprm" class="tprm-pipeline-filters" role="search" data-tp-list-controls>
    <label class="sr-only" for="pl-q">Search the pipeline</label>
    <input class="tpa-input" id="pl-q" type="search" name="q" value="<%= f.q %>" placeholder="Search a client, third party or person" data-tp-list-search>
    <label class="sr-only" for="pl-who">Whose</label>
    <select class="tpa-input" id="pl-who" name="who"><option value="">Everyone's</option><option value="mine"<%= f.who === 'mine' ? ' selected' : '' %>>Mine</option><option value="me"<%= f.who === 'me' ? ' selected' : '' %>>Waiting for me</option></select>
    <label class="sr-only" for="pl-waiting">Waiting on</label>
    <select class="tpa-input" id="pl-waiting" name="waiting"><option value="">Waiting on anyone</option><% waitingLabels && Object.entries(waitingLabels).forEach(([k, l]) => { %><option value="<%= k %>"<%= f.waiting === k ? ' selected' : '' %>>Waiting on: <%= l.toLowerCase() %></option><% }) %></select>
    <label class="tpa-option"><input type="checkbox" name="late" value="1"<%= f.late ? ' checked' : '' %>> Late only</label>
    <% if (f.sort !== 'due') { %><input type="hidden" name="sort" value="<%= f.sort %>"><% } %><% if (f.dir !== 'asc') { %><input type="hidden" name="dir" value="<%= f.dir %>"><% } %>
    <button class="tpa-btn" type="submit">Show</button>
  </form>
  <p class="tpa-meta" data-tp-list-count data-tp-total="<%= pl.rows.length %>">Showing <%= pl.rows.length %> of <%= pl.all %></p>
  <% if (!pl.rows.length) { %>
    <p class="tpa-empty" data-tprm-pipeline-empty><%= pl.all ? 'Nothing matches these filters.' : 'No assessment is open. Start one from a third party in a client\'s register.' %></p>
  <% } else { %>
  <div class="table-scroll"><table class="t tprm-pipeline-table">
    <thead><tr>
      <th scope="col" aria-sort="<%= ariaSort('client') %>" data-tp-sort="client"><a href="<%= sortHref('client') %>">Third party</a></th>
      <th scope="col" aria-sort="<%= ariaSort('step') %>" data-tp-sort="step"><a href="<%= sortHref('step') %>">Step</a></th>
      <th scope="col" aria-sort="<%= ariaSort('waiting') %>" data-tp-sort="waiting"><a href="<%= sortHref('waiting') %>">Waiting on</a></th>
      <th scope="col" class="tprm-right" aria-sort="<%= ariaSort('days') %>" data-tp-sort="days"><a href="<%= sortHref('days') %>">Days</a></th>
      <th scope="col" aria-sort="<%= ariaSort('due') %>" data-tp-sort="due"><a href="<%= sortHref('due') %>">Due</a></th>
    </tr></thead>
    <tbody data-tp-list>
    <% pl.rows.forEach(r => { %>
      <tr data-tp-row data-tp-text="<%= (r.clientName + ' ' + r.thirdPartyName + ' ' + r.step + ' ' + r.waitingLabel + ' ' + (r.waitingName || '')).toLowerCase() %>"
          data-tp-sort-client="<%= (r.clientName + ' ' + r.thirdPartyName).toLowerCase() %>" data-tp-sort-step="<%= r.step.toLowerCase() %>" data-tp-sort-waiting="<%= r.waitingLabel %>"
          data-tp-sort-days="<%= String(r.days).padStart(5, '0') %>" data-tp-sort-due="<%= r.due || '9999' %>"
          data-tprm-pipeline-row="<%= r.id %>" data-tprm-waiting="<%= r.waiting %>"<%- r.late ? ' data-tprm-late' : '' %>>
        <td><a href="/tprm/clients/<%= r.workspaceId %>/third-parties/<%= r.thirdPartyId %>/assessments/<%= r.id %>"><%= r.thirdPartyName %></a>
          <span class="tpa-meta tprm-block"><%= r.clientName %><% if (r.tier) { %> · <%= tierLabels[r.tier] || r.tier %><% } %><%= (r.typeLabel ? r.typeLabel === 'Reassessment' : r.type === 'reassessment') ? ' · reassessment' : '' %></span></td>
        <td><%= r.step %></td>
        <td><%= r.waitingLabel %><% if (r.waitingName) { %><span class="tpa-meta tprm-block"><%= r.waitingName %></span><% } %><% if (r.forMe) { %><span class="tpa-meta tprm-block" data-tprm-for-me>You</span><% } %></td>
        <td class="tprm-right" title="Days since the last change on this assessment"><%= r.days %></td>
        <td><% if (r.due) { %><% if (r.late) { %><%- include('partials/tprm_status', { text: day(r.due) + ', late', tone: 'problem' }) %><% } else { %><%= day(r.due) %><% } %><% } else { %><span class="tpa-meta">Not set</span><% } %></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</section>

<div class="tprm-stack">
<h2 class="fx-section-h">Clients <span><%= clients.length %></span></h2>
<% if (!clients.length) { %>
  <div class="fx-card"><div class="empty-state" data-tprm-empty>
    <div class="empty-title">No client has third-party risk switched on yet</div>
    <div class="meta">Choose "Third-party risk" when you create a client<%= availableClients.length ? ', or switch it on for an existing client below' : '' %>.</div>
  </div></div>
<% } else { const cardBy = new Map(((hb && hb.clients) || []).map(c => [Number(c.id), c])); %>
  <div class="fx-cards3" data-tprm-client-list>
  <% clients.forEach(c => { const k = cardBy.get(Number(c.id)) || { parties: 0, open: 0, late: 0, waitingClient: 0, requests: 0 }; %>
    <section class="fx-card fx-tile" data-tprm-client-row="<%= c.id %>">
      <h3 class="fx-h4"><a href="/tprm/clients/<%= c.id %>"><%= c.name %></a><span><%= c.sector || '' %></span></h3>
      <div class="fx-mini3"><div><b><%= k.parties %></b><span>Third parties</span></div><div><b class="<%= k.open ? 'fx-warn' : '' %>"><%= k.open %></b><span>Open reviews</span></div><div><b class="<%= k.late ? 'fx-bad' : '' %>"><%= k.late %></b><span>Late</span></div></div>
      <div class="fx-foot"><div>Waiting on the client<b><%= k.waitingClient ? k.waitingClient + ' decision' + (k.waitingClient === 1 ? '' : 's') : 'none' %></b></div><div data-tprm-client-requests="add">Requests to add<b><%= k.requests %></b></div><% if (k.reassessRequests) { %><div data-tprm-client-requests="reassess">Requests to reassess<b><%= k.reassessRequests %></b></div><% } %><div><a href="/tprm/clients/<%= c.id %>">Open register</a></div></div>
    </section>
  <% }) %>
  </div>
<% } %>

<% if (availableClients.length) { %>
<div class="panel" data-tprm-available>
  <div class="panel-head"><h2>Switch on third-party risk for an existing client</h2><span class="meta"><%= availableClients.length %></span></div>
  <div class="panel-pad meta text-xs" data-tprm-switch-on-hint>After you switch it on, tick the rulebooks the client is regulated under (RBI, SEBI, DORA and others) from "Tick rulebooks" below its name, so its questionnaires include the regulatory questions.</div>
  <% availableClients.forEach(c => { %>
    <form method="POST" action="/tprm/clients/<%= c.id %>/enable" class="tprm-list-row">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <span><strong><%= c.name %></strong><% if (c.sector) { %><span class="meta"><%= c.sector %></span><% } %></span>
      <button class="btn btn-secondary btn-xs" type="submit">Switch on</button>
    </form>
  <% }) %>
</div>
<% } %>

</div>
</div>
<%- include('partials/footer') %>
